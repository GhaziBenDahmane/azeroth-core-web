# MySQL accounts need access to all three AzerothCore databases.
# Set MOCK_MODE=true to run a self-contained demo without any database.
MOCK_MODE=false
PORTAL_BIND=127.0.0.1
PORTAL_PORT=8080
AUTH_DSN=acore:change-me@tcp(host.docker.internal:3306)/acore_auth
CHARACTERS_DSN=acore:change-me@tcp(host.docker.internal:3306)/acore_characters
WORLD_DSN=acore:change-me@tcp(host.docker.internal:3306)/acore_world
AUTH_DB=acore_auth
CHARACTERS_DB=acore_characters
WORLD_DB=acore_world

PUBLIC_URL=http://localhost:8080
REALM_NAME=Azeroth
REALM_ADDRESS=logon.example.com

# Runtime branding. Reuse the same image for a different realm without rebuilding it.
PORTAL_NAME=Azeroth
BRAND_MARK=A
PORTAL_TAGLINE=A timeless realm, shaped by its community. Forge alliances, conquer raids, and write your story.
EXPANSION_NAME=Wrath of the Lich King
CLIENT_VERSION=3.3.5a
CLIENT_BUILD=12340
EXPERIENCE_RATE=2x
UPTIME_LABEL=24/7
FOOTER_TEXT=Independent community realm portal. Not affiliated with Blizzard Entertainment.
DOWNLOAD_URL=
COMMUNITY_URL=
LOGO_URL=
HERO_IMAGE_URL=
FAVICON_URL=
THEME_PRIMARY="#d3ae68"
THEME_SECONDARY="#f3d89c"
THEME_ACCENT="#3fd0be"
THEME_BACKGROUND="#07110f"
TERMS_URL=
PRIVACY_URL=
PORTAL_LOCALE=en
# Optional JSON overrides for elements marked with data-i18n.
UI_TEXT_JSON={}
# Up to 12 items: [{"title":"Season launch","summary":"Welcome!","date":"2026-08-28","url":"https://example.com/news"}]
NEWS_JSON=[]

# Disable modules that are not offered by this realm. Disabled APIs return 404 too.
ENABLE_REGISTRATION=true
ENABLE_ARMORY=true
ENABLE_RANKINGS=true
ENABLE_GUILDS=true
ENABLE_REALM_STATUS=true
ENABLE_SHOP=true
ENABLE_SUPPORT=true
ENABLE_ADMIN_PANEL=true

# Optional GM browser console. Keep allow-all disabled unless level-3 GMs require full worldserver access.
ENABLE_GM_CONSOLE=false
GM_CONSOLE_LEVEL=3
GM_CONSOLE_ALLOW_ALL=false
GM_CONSOLE_ALLOWED_PREFIXES=help,server info,server motd,account online list,lookup,player info

# Optional one-time web setup. Disable and remove the token after onboarding.
ENABLE_SETUP=false
SETUP_TOKEN=
SETUP_GM_LEVEL=3
SETUP_GM_REALM_ID=-1

ACCOUNT_EXPANSION=2
REALM_ID=1
GM_LEVEL=3
STARTING_CREDITS=0
COOKIE_SECURE=false
# Enable only when direct access is blocked and your reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# AzerothCore worldserver SOAP. Use a dedicated account with only the command permissions it needs.
SOAP_URL=
SOAP_USER=
SOAP_PASSWORD=

# Optional control-plane endpoint used to start an offline worldserver.
# The endpoint receives POST {} with this token as a Bearer credential.
REALM_START_WEBHOOK=
REALM_CONTROL_TOKEN=

# Optional bearer credential for product automation. GM browser sessions work without it.
ADMIN_TOKEN=

# Optional Stripe Checkout credit packages. Use Stripe Price IDs, never browser-supplied amounts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SMALL=
STRIPE_PRICE_MEDIUM=
STRIPE_PRICE_LARGE=

# Optional account protection. Turnstile is enforced only when its secret is set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Locks new accounts until they follow a one-time link. Requires SMTP_ADDR and SMTP_FROM.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_ADDR=smtp.example.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
