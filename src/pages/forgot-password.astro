---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Password recovery — Azeroth" page="forgot-password"><section class="auth-shell wrap compact"><div class="auth-aside"><p class="eyebrow">ACCOUNT RECOVERY</p><h1>RETURN TO<br/><em>THE FIGHT.</em></h1><p>We will send a one-hour, single-use reset link if the address belongs to an account.</p></div><form id="forgot-form" class="form-card"><p class="eyebrow">PASSWORD RESET</p><h2>Find your account</h2><label>Email<input name="email" type="email" autocomplete="email" required/></label><button class="button full">Send reset link →</button><p class="form-message"></p></form></section></Layout>
