---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Administration — Azeroth" page="admin">
  <section class="page-hero wrap admin-hero"><div><p class="eyebrow">Control panel</p><h1>Administration</h1><p>Players, commerce, content, support, and worldserver operations in one secured workspace.</p></div><a class="ghost-button" href="/account">My account</a></section>
  <section id="admin-access" class="wrap admin-shell hidden">
    <nav class="admin-sidebar" aria-label="Administration sections">
      <p class="eyebrow">CONTROL PANEL</p>
      <a class="active" data-admin-route="overview" href="/admin">Overview</a>
      <a data-admin-route="monitoring" href="/admin/monitoring">Monitoring</a>
      <a data-admin-route="catalog" href="/admin/catalog">Shop catalog</a>
      <a data-admin-route="players" href="/admin/players/accounts">Players</a>
      <a data-admin-route="realm-admin" href="/admin/realm/operations">Realm operations</a>
      <a data-admin-route="content" href="/admin/content">Content & coupons</a>
      <a data-admin-route="support-admin" href="/admin/support">Support</a>
      <a data-admin-route="settings" href="/admin/settings">Configuration</a>
      <a data-admin-route="audit" href="/admin/audit">Audit logs</a>
    </nav>
    <div class="admin-workspace">
      <section class="admin-view active" data-admin-view="overview"><div class="admin-view-head"><div><p class="eyebrow">OVERVIEW</p><h2>Operations dashboard</h2></div><button class="ghost-button" data-admin-refresh>Refresh</button></div><div class="admin-dashboard-grid"><article class="account-panel"><h3>Delivery queue</h3><div id="admin-orders" class="admin-table"><p class="muted">Loading…</p></div></article><article class="account-panel"><h3>Credit ledger</h3><div id="credit-ledger" class="admin-table"><p class="muted">Loading…</p></div></article></div></section>

      <section class="admin-view" data-admin-view="monitoring"><div class="admin-view-head"><div><p class="eyebrow">MONITORING</p><h2>Service health</h2><p>Technical availability for the portal, databases, realm, and delivery worker.</p></div><button class="ghost-button" data-monitoring-refresh>Refresh</button></div><div id="admin-service-status" class="status-grid"><div class="skeleton"></div></div><h3 class="admin-section-title">Maintenance and announcements</h3><div id="admin-scheduled-announcements" class="news-grid"></div></section>

      <section class="admin-view" data-admin-view="catalog"><div id="catalog-list"><div class="admin-view-head"><div><p class="eyebrow">COMMERCE</p><h2>Shop catalog</h2><p>Search, sort, inspect, and edit complete delivery packages.</p></div><a id="catalog-new" class="button small" href="/admin/catalog/new">New product</a></div><div class="admin-table-tools"><input id="catalog-table-search" type="search" placeholder="Search products, categories, classes…"/><select id="catalog-table-status"><option value="all">All statuses</option><option value="active">Active</option><option value="archived">Archived</option></select></div><div class="data-table-wrap"><table class="data-table catalog-data-table"><thead><tr><th><button data-catalog-sort="id">ID</button></th><th><button data-catalog-sort="name">Product</button></th><th><button data-catalog-sort="category">Category</button></th><th>Package</th><th><button data-catalog-sort="price">Price</button></th><th><button data-catalog-sort="active">Status</button></th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="admin-products"><tr><td colspan="7">Loading catalog…</td></tr></tbody></table></div></div>
        <form id="catalog-editor" class="gm-panel catalog-editor hidden"><input name="id" type="hidden"/><div class="panel-title"><div><p class="eyebrow">PRODUCT EDITOR</p><h3 id="catalog-editor-title">New product</h3></div><label class="check"><input name="active" type="checkbox" checked/> Active</label></div><div class="gm-fields"><label>Name<input name="name" maxlength="100" required/></label><label>Credit price<input name="price" type="number" min="1" max="10000000" required/></label></div><div class="gm-fields"><label>Category<input name="category" value="Items" maxlength="40" required/></label><label>Class restriction<select name="classId"><option value="0">Any class</option><option value="1">Warrior</option><option value="2">Paladin</option><option value="3">Hunter</option><option value="4">Rogue</option><option value="5">Priest</option><option value="6">Death Knight</option><option value="7">Shaman</option><option value="8">Mage</option><option value="9">Warlock</option><option value="11">Druid</option></select></label></div><div class="gm-fields"><label>Tier / label<input name="tier" maxlength="30"/></label><label>Level service<input name="serviceLevel" type="number" min="0" max="80" value="0"/></label></div><div class="gm-fields"><label>Gold amount<input name="gold" type="number" min="0" max="200000" value="0"/><small>Gold delivered with this package.</small></label><label>Character service<select name="serviceAction"><option value="">None</option><option value="race_change">Race change</option><option value="faction_change">Faction change</option></select></label></div><label>Description<textarea name="description" maxlength="500"></textarea></label><div class="gm-fields"><label>Available from<input name="startsAt" type="datetime-local"/></label><label>Available until<input name="endsAt" type="datetime-local"/></label></div><label>Purchases per account (0 unlimited)<input name="perAccountLimit" type="number" min="0" max="100000" value="0"/></label>
          <div class="catalog-item-picker"><label>Find WotLK items, equipment, consumables, or bags<input id="catalog-item-search" type="search" placeholder="Type an item name or ID" autocomplete="off"/></label><div id="catalog-item-results" class="item-search-results"></div></div><p id="catalog-product-kind" class="catalog-product-kind">Service or gold product · no items</p><div class="catalog-preview"><div><p class="eyebrow">EQUIPMENT PREVIEW</p><div id="catalog-equipment" class="catalog-equipment"></div></div><div><p class="eyebrow">PACKAGE CONTENTS</p><div id="catalog-items" class="catalog-items"></div></div></div><p class="muted">One item is stored as a direct item product. Two or more items are stored as a set/bundle. Bags are bundle items; gems and enchant scrolls are delivered for players to apply in game.</p><div class="row-actions"><button class="button" type="submit">Save product</button><button id="catalog-archive" class="ghost-button hidden" type="button">Archive</button><button id="catalog-cancel" class="ghost-button" type="button">Close</button></div><p class="form-message"></p></form>
      </section>

      <section class="admin-view" data-admin-view="players"><div class="admin-view-head"><div><p class="eyebrow">PLAYERS</p><h2>Player management</h2></div></div><nav class="admin-subnav"><a data-admin-subroute="accounts" href="/admin/players/accounts">Accounts</a><a data-admin-subroute="credits" href="/admin/players/credits">Credits</a><a data-admin-subroute="moderation" href="/admin/players/moderation">Moderation</a></nav><div class="admin-subview" data-admin-subview="accounts"><article class="account-panel"><form id="gm-account-search"><h3>Player lookup</h3><div class="gm-search"><input name="q" placeholder="Account name or email" maxlength="64"/><button class="button" type="submit">Search</button></div><p class="form-message"></p></form><div id="admin-accounts" class="admin-table"></div></article></div><div class="admin-subview" data-admin-subview="credits"><form id="gm-credit-form" class="gm-panel"><h3>Grant account credits</h3><div class="gm-fields"><label>Account<input name="username" maxlength="32" required/></label><label>Credits<input name="amount" type="number" min="1" max="1000000" required/></label></div><label>Audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Grant credits</button><p class="form-message"></p></form></div><div class="admin-subview" data-admin-subview="moderation"><form id="gm-moderation-form" class="gm-panel"><h3>Account moderation</h3><label>Action<select name="action"><option value="ban">Ban account</option><option value="unban">Unban account</option><option value="kick">Kick character</option></select></label><label>Account or character<input name="target" maxlength="32" required/></label><label data-moderation-field="duration">Duration<input name="duration" value="7d" maxlength="20"/><small>Examples: 30m, 7d, 1w, or -1.</small></label><label>Audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Apply action</button><p class="form-message"></p></form></div></section>

      <section class="admin-view" data-admin-view="realm-admin"><div class="admin-view-head"><div><p class="eyebrow">WORLDSERVER</p><h2>Realm operations</h2></div></div><nav class="admin-subnav"><a data-admin-subroute="operations" href="/admin/realm/operations">Operations</a><a data-admin-subroute="console" href="/admin/realm/console">Command console</a></nav><div class="admin-subview" data-admin-subview="operations"><form id="gm-operation-form" class="gm-panel reactive-form"><h3 id="operation-title">Start realm</h3><label>Action<select name="action"><option value="start">Start realm</option><option value="mute">Mute character</option><option value="unmute">Unmute character</option><option value="ip_ban">Ban IP</option><option value="ip_unban">Unban IP</option><option value="gm_level">Set GM level</option><option value="announce">Announcement</option><option value="motd">Set MOTD</option><option value="restart">Schedule restart</option><option value="shutdown">Schedule shutdown</option><option value="cancel_shutdown">Cancel shutdown/restart</option></select></label><label data-operation-field="target">Target<input name="target" placeholder="Character, account, or IP" maxlength="64"/></label><label data-operation-field="duration">Duration / delay<input name="duration" placeholder="Minutes, duration, or seconds" maxlength="20"/></label><div class="gm-fields" data-operation-field="gm"><label>GM level<input name="level" type="number" min="0" max="3" value="0"/></label><label>Realm ID<input name="realmId" type="number" min="-1" value="-1"/></label></div><label data-operation-field="reason">Message or audit reason<input name="reason" minlength="3" maxlength="255" required/></label><p id="operation-help" class="muted"></p><button class="button" type="submit">Execute operation</button><p class="form-message"></p></form></div><div class="admin-subview" data-admin-subview="console"><section id="gm-command-console" class="gm-panel gm-command-console"><h3>Worldserver console</h3><div id="gm-command-disabled"><p class="muted">Disabled by default. Set <code>ENABLE_GM_CONSOLE=true</code> to enable audited browser commands.</p></div><div id="gm-command-enabled" class="hidden"><p class="muted">Commands execute with the configured SOAP account and are permanently audited.</p><form id="gm-command-form"><div class="command-line"><span>&gt;</span><input name="command" maxlength="255" autocomplete="off" spellcheck="false" placeholder="server info" required/><button class="button" type="submit">Run</button></div><p class="form-message"></p></form><pre id="gm-command-output" aria-live="polite">Console ready.</pre><div class="console-policy"><small id="gm-command-policy"></small></div><h3>Recent commands</h3><div id="gm-command-history" class="admin-table"></div></div></section></div></section>

      <section class="admin-view" data-admin-view="content"><div class="admin-view-head"><div><p class="eyebrow">CONTENT</p><h2>News and promotions</h2></div></div><div class="admin-dashboard-grid"><article class="account-panel"><form id="gm-news-form"><h3>Publish news or announcement</h3><div class="gm-fields"><label>Title<input name="title" maxlength="120" required/></label><label>Type<select name="kind"><option value="news">News</option><option value="announcement">Announcement</option><option value="maintenance">Maintenance</option></select></label></div><label>Summary<textarea name="summary" maxlength="1000"></textarea></label><label>Link<input name="url" maxlength="500"/></label><div class="gm-fields"><label>Publish at<input name="publishAt" type="datetime-local"/></label><label>Expires at<input name="expiresAt" type="datetime-local"/></label></div><button class="button" type="submit">Publish</button><p class="form-message"></p></form><div id="admin-news" class="admin-table"></div></article><article class="account-panel"><form id="gm-coupon-form"><h3>Create coupon</h3><div class="gm-fields"><label>Code<input name="code" pattern="[A-Za-z0-9_-]{3,40}" required/></label><label>Percent off<input name="discountPercent" type="number" min="0" max="100" value="10"/></label></div><div class="gm-fields"><label>Fixed credits off<input name="discountCredits" type="number" min="0" value="0"/></label><label>Total uses (0 unlimited)<input name="maxUses" type="number" min="0" value="0"/></label></div><div class="gm-fields"><label>Starts<input name="startsAt" type="datetime-local"/></label><label>Ends<input name="endsAt" type="datetime-local"/></label></div><label>Uses per account<input name="perAccountLimit" type="number" min="1" value="1"/></label><button class="button" type="submit">Create coupon</button><p class="form-message"></p></form><div id="admin-coupons" class="admin-table"></div></article></div></section>

      <section class="admin-view" data-admin-view="support-admin"><div class="admin-view-head"><div><p class="eyebrow">SUPPORT</p><h2>Player tickets</h2></div></div><article class="account-panel"><div id="admin-tickets" class="admin-table"><p class="muted">Loading…</p></div></article></section>

      <section class="admin-view" data-admin-view="settings"><div class="admin-view-head"><div><p class="eyebrow">CONFIGURATION</p><h2>Website settings</h2></div></div><form id="gm-settings-form" class="gm-panel"><div class="gm-fields"><label>Portal name<input name="portalName" required/></label><label>Realm name<input name="realmName" required/></label></div><div class="gm-fields"><label>Brand mark<input name="brandMark" maxlength="3" required/></label><label>Realm address<input name="realmAddress" required/></label></div><div class="gm-fields"><label>Experience rate<input name="experienceRate" placeholder="2×" maxlength="30" required/></label><span></span></div><label>Tagline<textarea name="tagline" maxlength="500"></textarea></label><div class="gm-fields"><label>Download URL<input name="downloadUrl"/></label><label>Community URL<input name="communityUrl"/></label></div><div class="gm-fields"><label>Terms URL<input name="termsUrl"/></label><label>Privacy URL<input name="privacyUrl"/></label></div><div class="gm-fields"><label>Primary color<input name="themePrimary" type="color"/></label><label>Accent color<input name="themeAccent" type="color"/></label></div><div class="gm-fields"><label>Secondary color<input name="themeSecondary" type="color"/></label><label>Background color<input name="themeBackground" type="color"/></label></div><label class="check"><input name="maintenanceEnabled" type="checkbox"/> Maintenance mode</label><label>Maintenance message<input name="maintenanceMessage" maxlength="500"/></label><div class="gm-fields"><label>Starts<input name="maintenanceStarts" type="datetime-local"/></label><label>Ends<input name="maintenanceEnds" type="datetime-local"/></label></div><fieldset class="feature-switches"><legend>Features</legend><label><input name="registration" type="checkbox"/> Registration</label><label><input name="armory" type="checkbox"/> Armory</label><label><input name="rankings" type="checkbox"/> Rankings</label><label><input name="guilds" type="checkbox"/> Guilds</label><label><input name="realm" type="checkbox"/> Realm status</label><label><input name="shop" type="checkbox"/> Shop</label><label><input name="support" type="checkbox"/> Support</label><label><input name="admin" type="checkbox"/> Admin panel</label><label><input name="gmConsole" type="checkbox"/> GM console</label></fieldset><button class="button" type="submit">Save settings</button><p class="form-message"></p></form></section>

      <section class="admin-view" data-admin-view="audit"><div class="admin-view-head"><div><p class="eyebrow">AUDIT</p><h2>Moderation history</h2></div></div><article class="account-panel"><div id="moderation-log" class="admin-table"><p class="muted">Loading…</p></div></article></section>
    </div>
  </section>
  <section id="admin-denied" class="wrap admin-denied hidden"><p class="eyebrow">ACCESS DENIED</p><h1>GM access required</h1><p>This area is restricted to authorized realm staff.</p><a class="button" href="/account">Return to account</a></section>
</Layout>
