---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Administration — Azeroth" page="admin">
  <section class="page-hero wrap admin-hero"><div><p class="eyebrow">Control panel</p><h1>Administration</h1><p>Players, commerce, content, support, and worldserver operations in one secured workspace.</p></div></section>
  <section id="admin-access" class="wrap admin-shell hidden">
    <nav class="admin-sidebar" aria-label="Administration sections">
      <p class="eyebrow">CONTROL PANEL</p>
      <a class="active" data-admin-route="overview" data-permission="overview" href="/admin">Overview</a>
      <a data-admin-route="monitoring" data-permission="monitoring" href="/admin/monitoring">Monitoring</a>
      <a data-admin-route="catalog" data-permission="commerce" href="/admin/catalog">Shop catalog</a>
      <a data-admin-route="players" data-permission="players" href="/admin/players/accounts">Players</a>
      <a data-admin-route="realm-admin" data-permission="realm" href="/admin/realm/operations">Realm operations</a>
      <a data-admin-route="content" data-permission="content" href="/admin/content/news">Content studio</a>
      <a data-admin-route="support-admin" data-permission="support" href="/admin/support">Support</a>
      <a data-admin-route="settings" data-permission="settings" href="/admin/settings/branding">Configuration</a>
      <a data-admin-route="staff" data-permission="admin" href="/admin/staff">Staff</a>
      <a data-admin-route="audit" data-permission="audit" href="/admin/audit">Audit logs</a>
      <a data-admin-route="privacy" data-permission="players" href="/admin/privacy">Privacy</a>
    </nav>
    <div class="admin-workspace"><nav id="admin-breadcrumb" class="admin-breadcrumb" aria-label="Breadcrumb"><a href="/admin">Administration</a><span aria-hidden="true">/</span><span>Dashboard</span></nav>
      <section class="admin-view active" data-admin-view="overview"><div class="admin-view-head"><div><p class="eyebrow">OVERVIEW</p><h2>Operations dashboard</h2></div><button class="ghost-button" data-admin-refresh>Refresh</button></div><div id="admin-analytics" class="admin-analytics"><div class="skeleton"></div></div><div class="admin-dashboard-grid"><article class="account-panel"><div class="panel-title"><h3>Delivery queue</h3><div class="row-actions"><button id="orders-select-all" class="ghost-button">Select retryable</button><button id="orders-bulk-retry" class="ghost-button">Retry selected</button></div></div><div id="orders-bulk-results" class="notice-box hidden" aria-live="polite"></div><div id="admin-orders" class="admin-table"><p class="muted">Loading…</p></div></article><article class="account-panel"><h3>Credit ledger</h3><div id="credit-ledger" class="admin-table"><p class="muted">Loading…</p></div></article></div></section>

      <section class="admin-view" data-admin-view="monitoring"><div class="admin-view-head"><div><p class="eyebrow">MONITORING</p><h2>Service health</h2><p>Technical availability for the portal, databases, realm, and delivery worker.</p></div><button class="ghost-button" data-monitoring-refresh>Refresh</button></div><div id="admin-service-status" class="status-grid"><div class="skeleton"></div></div><article id="delivery-diagnostic" class="account-panel hidden"><div class="panel-title"><div><p class="eyebrow">CONTROLLED DELIVERY TEST</p><h3>Verify worldserver delivery</h3></div><button class="ghost-button" id="run-delivery-diagnostic" type="button">Send test item</button></div><p id="delivery-diagnostic-summary" class="muted"></p><div id="delivery-diagnostic-result" class="notice-box hidden" aria-live="polite"></div></article><h3 class="admin-section-title">Maintenance and announcements</h3><div id="admin-scheduled-announcements" class="news-grid"></div></section>

      <section class="admin-view" data-admin-view="catalog"><div id="catalog-list"><div class="admin-view-head"><div><p class="eyebrow">COMMERCE</p><h2>Shop catalog</h2><p>Search, sort, inspect, and edit complete delivery packages.</p></div><div class="row-actions"><button id="catalog-export" class="ghost-button">Export CSV</button><a id="catalog-new" class="button small" href="/admin/catalog/new">New product</a></div></div><div class="admin-table-tools"><input id="catalog-table-search" type="search" placeholder="Search products, categories, classes…"/><select id="catalog-table-status"><option value="all">All statuses</option><option value="active">Active</option><option value="archived">Archived</option></select></div><div class="data-table-wrap"><table class="data-table catalog-data-table"><thead><tr><th><button data-catalog-sort="id">ID</button></th><th><button data-catalog-sort="name">Product</button></th><th><button data-catalog-sort="category">Category</button></th><th>Package</th><th><button data-catalog-sort="price">Price</button></th><th><button data-catalog-sort="active">Status</button></th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="admin-products"><tr><td colspan="7">Loading catalog…</td></tr></tbody></table></div></div>
        <form id="catalog-editor" class="gm-panel catalog-editor hidden"><input name="id" type="hidden"/><div class="panel-title"><div><p class="eyebrow">PRODUCT EDITOR</p><h3 id="catalog-editor-title">New product</h3></div><div class="editor-switches"><label class="check"><input name="featured" type="checkbox"/> Featured</label><label class="check"><input name="active" type="checkbox" checked/> Active</label></div></div><div class="gm-fields"><label>Name<input name="name" maxlength="100" required/></label><label>Regular credit price<input name="price" type="number" min="1" max="10000000" required/></label></div><div class="gm-fields"><label>Sale price (0 disables)<input name="salePrice" type="number" min="0" max="9999999" value="0"/><small>Must be lower than the regular price.</small></label><label>Stock limit (0 unlimited)<input name="stockLimit" type="number" min="0" max="1000000" value="0"/><small>Existing sales: <b id="catalog-sold-count">0</b></small></label></div><div class="gm-fields"><label>Category<input name="category" value="Items" maxlength="40" required/></label><label>Category display order<input name="categoryOrder" type="number" min="-10000" max="10000" value="0"/></label></div><div class="gm-fields"><label>Class restriction<select name="classId"><option value="0">Any class</option><option value="1">Warrior</option><option value="2">Paladin</option><option value="3">Hunter</option><option value="4">Rogue</option><option value="5">Priest</option><option value="6">Death Knight</option><option value="7">Shaman</option><option value="8">Mage</option><option value="9">Warlock</option><option value="11">Druid</option></select></label><label>Tier / label<input name="tier" maxlength="30"/></label></div><div class="gm-fields"><label>Level service<input name="serviceLevel" type="number" min="0" max="80" value="0"/></label><label>Gold amount<input name="gold" type="number" min="0" max="200000" value="0"/><small>Gold delivered with this package.</small></label></div><label>Character service<select name="serviceAction"><option value="">None</option><option value="race_change">Race change</option><option value="faction_change">Faction change</option></select></label><label>Description<textarea name="description" maxlength="500"></textarea></label><div class="gm-fields"><label>Available from<input name="startsAt" type="datetime-local"/></label><label>Available until<input name="endsAt" type="datetime-local"/></label></div><label>Purchases per account (0 unlimited)<input name="perAccountLimit" type="number" min="0" max="100000" value="0"/></label>
          <div class="catalog-item-picker"><label>Find WotLK items, equipment, consumables, or bags<input id="catalog-item-search" type="search" placeholder="Type an item name or ID" autocomplete="off"/></label><div id="catalog-item-results" class="item-search-results"></div></div><p id="catalog-product-kind" class="catalog-product-kind">Service or gold product · no items</p><div class="catalog-preview"><div><p class="eyebrow">EQUIPMENT PREVIEW</p><div id="catalog-equipment" class="catalog-equipment"></div></div><div><p class="eyebrow">PACKAGE CONTENTS</p><div id="catalog-items" class="catalog-items"></div></div></div><p class="muted">One item is stored as a direct item product. Two or more items are stored as a set/bundle. Bags are bundle items; gems and enchant scrolls are delivered for players to apply in game.</p><div class="row-actions"><button class="button" type="submit">Save product</button><button id="catalog-archive" class="ghost-button hidden" type="button">Archive</button><button id="catalog-cancel" class="ghost-button" type="button">Close</button></div><p class="form-message"></p></form>
      </section>

      <section class="admin-view" data-admin-view="players"><div class="admin-view-head"><div><p class="eyebrow">PLAYERS</p><h2>Player management</h2></div></div><nav class="admin-subnav"><a data-admin-subroute="accounts" data-permission="players" href="/admin/players/accounts">Accounts</a><a data-admin-subroute="credits" data-permission="commerce" href="/admin/players/credits">Credits</a><a data-admin-subroute="moderation" data-permission="moderation" href="/admin/players/moderation">Moderation</a></nav><div class="admin-subview" data-admin-subview="accounts"><article class="account-panel"><form id="gm-account-search"><h3>Player lookup</h3><div class="gm-search"><label>Account name or email<input name="q" placeholder="Search accounts" maxlength="64"/></label><button class="button" type="submit">Search</button></div><p class="form-message"></p></form><div id="admin-accounts" class="admin-table"></div></article></div><div class="admin-subview" data-admin-subview="credits"><form id="gm-credit-form" class="gm-panel"><h3>Grant account credits</h3><div class="gm-fields"><label>Account<input name="username" maxlength="32" required/></label><label>Credits<input name="amount" type="number" min="1" max="1000000" required/></label></div><label>Audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Grant credits</button><p class="form-message"></p></form></div><div class="admin-subview" data-admin-subview="moderation"><form id="gm-moderation-form" class="gm-panel"><h3>Account moderation</h3><label>Action<select name="action"><option value="ban">Ban account</option><option value="unban">Unban account</option><option value="kick">Kick character</option></select></label><label>Account or character<input name="target" maxlength="32" required/></label><label data-moderation-field="duration">Duration<input name="duration" value="7d" maxlength="20"/><small>Examples: 30m, 7d, 1w, or -1.</small></label><label>Audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Apply action</button><p class="form-message"></p></form><article class="account-panel"><h3>Sanction appeals</h3><div id="admin-sanction-appeals" class="admin-table"><p class="muted">Loading…</p></div></article></div></section>

      <section class="admin-view" data-admin-view="realm-admin"><div class="admin-view-head"><div><p class="eyebrow">WORLDSERVER</p><h2>Realm operations</h2></div></div><nav class="admin-subnav"><a data-admin-subroute="operations" data-permission="realm" href="/admin/realm/operations">Operations</a><a data-admin-subroute="configuration" data-permission="realm" href="/admin/realm/configuration">Configuration</a><a data-admin-subroute="console" data-permission="console" href="/admin/realm/console">Command console</a></nav><div class="admin-subview" data-admin-subview="operations"><form id="gm-operation-form" class="gm-panel reactive-form"><h3 id="operation-title">Start realm</h3><label>Action<select name="action"><option value="start">Start realm</option><option value="mute">Mute character</option><option value="unmute">Unmute character</option><option value="ip_ban">Ban IP</option><option value="ip_unban">Unban IP</option><option value="gm_level">Set GM level</option><option value="announce">Announcement</option><option value="motd">Set MOTD</option><option value="restart">Schedule restart</option><option value="shutdown">Schedule shutdown</option><option value="cancel_shutdown">Cancel shutdown/restart</option></select></label><label data-operation-field="target">Target<input name="target" placeholder="Character, account, or IP" maxlength="64"/></label><label data-operation-field="duration">Duration / delay<input name="duration" placeholder="Minutes, duration, or seconds" maxlength="20"/></label><div class="gm-fields" data-operation-field="gm"><label>GM level<input name="level" type="number" min="0" max="3" value="0"/></label><label>Realm ID<input name="realmId" type="number" min="-1" value="-1"/></label></div><label data-operation-field="reason">Message or audit reason<input name="reason" minlength="3" maxlength="255" required/></label><p id="operation-help" class="muted"></p><button class="button" type="submit">Execute operation</button><p class="form-message"></p></form></div><div class="admin-subview" data-admin-subview="configuration"><article class="account-panel"><div class="panel-title"><div><p class="eyebrow">SAFE CONFIGURATION</p><h3>Desired and observed values</h3></div><button id="realm-config-refresh" class="ghost-button" type="button">Refresh</button></div><div id="realm-config-summary" class="notice-box"><p>Checking configuration agent…</p></div><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Setting</th><th>Portal value</th><th>Worldserver value</th><th>State</th></tr></thead><tbody id="realm-config-items"><tr><td colspan="4">Loading…</td></tr></tbody></table></div><div class="row-actions"><button id="realm-config-apply" class="button hidden" type="button">Review and apply changes</button></div></article></div><div class="admin-subview" data-admin-subview="console"><section id="gm-command-console" class="gm-panel gm-command-console"><h3>Worldserver console</h3><div id="gm-command-disabled"><p class="muted">Disabled by default. Set <code>ENABLE_GM_CONSOLE=true</code> to enable audited browser commands.</p></div><div id="gm-command-enabled" class="hidden"><p class="muted">Commands execute with the configured SOAP account and are permanently audited.</p><form id="gm-command-form"><div class="command-line"><span>&gt;</span><input name="command" aria-label="Worldserver command" maxlength="255" autocomplete="off" spellcheck="false" placeholder="server info" required/><button class="button" type="submit">Run</button></div><p class="form-message"></p></form><pre id="gm-command-output" aria-live="polite">Console ready.</pre><div class="console-policy"><small id="gm-command-policy"></small></div><h3>Recent commands</h3><div id="gm-command-history" class="admin-table"></div></div></section></div></section>

      <section class="admin-view" data-admin-view="content">
        <div class="admin-view-head"><div><p class="eyebrow">CONTENT</p><h2>Content studio</h2><p>Edit one publishing area at a time.</p></div></div>
        <div class="admin-dashboard-grid">
          <article class="account-panel cms-panel"><form id="gm-news-form"><input name="id" type="hidden"/><div class="panel-title"><div><p class="eyebrow">ARTICLE EDITOR</p><h3 id="news-editor-title">New article</h3></div><button id="news-editor-reset" class="ghost-button" type="button">New</button></div><div class="gm-fields"><label>Title<input name="title" maxlength="120" required/></label><label>URL slug<input name="slug" maxlength="160" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="generated-from-title"/></label></div><div class="gm-fields"><label>Type<select name="kind"><option value="news">News</option><option value="announcement">Announcement</option><option value="maintenance">Maintenance</option></select></label><label>Status<select name="status"><option value="draft">Draft</option><option value="published">Published</option><option value="archived">Archived</option></select></label></div><label>Summary<textarea name="summary" maxlength="1000" rows="3"></textarea></label><label>Article body<textarea name="body" maxlength="100000" rows="12" placeholder="Write the complete article. Plain text is rendered safely with paragraphs preserved."></textarea></label><div class="gm-fields"><label>Cover image URL<input name="coverUrl" maxlength="500"/></label><label>Optional external link<input name="url" maxlength="500"/></label></div><div class="gm-fields"><label>Author display name<input name="authorName" maxlength="100"/></label><label>Tags<input name="tags" maxlength="500" placeholder="events, progression, changelog"/></label></div><div class="gm-fields"><label>Publish at<input name="publishAt" type="datetime-local"/></label><label>Expires at<input name="expiresAt" type="datetime-local"/></label></div><div class="row-actions"><button class="button" type="submit">Save article</button><button id="news-preview" class="ghost-button" type="button">Preview</button></div><p class="form-message"></p></form><div id="news-preview-panel" class="article-preview hidden"></div><h3>Articles</h3><div id="admin-news" class="admin-table"></div><div id="admin-news-revisions" class="admin-table hidden"></div></article>
          <article class="account-panel"><form id="gm-coupon-form"><h3>Create coupon</h3><div class="gm-fields"><label>Code<input name="code" pattern="[A-Za-z0-9_-]{3,40}" required/></label><label>Percent off<input name="discountPercent" type="number" min="0" max="100" value="10"/></label></div><div class="gm-fields"><label>Fixed credits off<input name="discountCredits" type="number" min="0" value="0"/></label><label>Total uses (0 unlimited)<input name="maxUses" type="number" min="0" value="0"/></label></div><div class="gm-fields"><label>Starts<input name="startsAt" type="datetime-local"/></label><label>Ends<input name="endsAt" type="datetime-local"/></label></div><label>Uses per account<input name="perAccountLimit" type="number" min="1" value="1"/></label><button class="button" type="submit">Create coupon</button><p class="form-message"></p></form><div id="admin-coupons" class="admin-table"></div></article>
          <article class="account-panel"><form id="gm-vote-site-form"><h3>Add voting site</h3><div class="gm-fields"><label>Name<input name="name" maxlength="100" required/></label><label>Slug<input name="slug" pattern="[a-z0-9][a-z0-9-]{1,49}" placeholder="top100arena" required/></label></div><label>Vote URL<input name="url" type="url" required/></label><label>Description<textarea name="description" maxlength="500"></textarea></label><div class="gm-fields"><label>Reward credits<input name="rewardCredits" type="number" min="0" max="100000" value="5" required/></label><label>Cooldown minutes<input name="cooldownMinutes" type="number" min="5" max="10080" value="720" required/></label></div><label>Display order<input name="sortOrder" type="number" value="0"/></label><button class="button" type="submit">Add voting site</button><p class="form-message"></p></form><div id="admin-vote-sites" class="admin-table"></div></article>
          <article class="account-panel"><form id="vote-campaign-form"><h3>Schedule voting draw</h3><label>Campaign name<input name="name" maxlength="120" required/></label><label>Description<textarea name="description" maxlength="500"></textarea></label><div class="gm-fields"><label>Starts<input name="startsAt" type="datetime-local" required/></label><label>Ends<input name="endsAt" type="datetime-local" required/></label></div><div class="gm-fields"><label>Minimum votes<input name="minimumVotes" type="number" min="1" value="1" required/></label><label>Winners<input name="winnerCount" type="number" min="1" max="100" value="1" required/></label></div><label>Prize description<input name="prizeDescription" maxlength="255" required/></label><details><summary>Optional community goal</summary><div class="gm-fields"><label>Verified-vote target<input name="targetEntries" type="number" min="0" max="10000000" value="0"/></label><label>Realm-wide reward<input name="communityRewardDescription" maxlength="255" placeholder="Bonus XP weekend"/></label></div><small>Set both fields to publish a shared goal. Applying the in-game reward remains an operator action.</small></details><button class="button" type="submit">Publish committed draw</button><p class="form-message" role="status"></p></form><div id="admin-vote-campaigns" class="admin-table"></div></article>
          <article class="account-panel"><form id="mission-form"><input name="id" type="hidden"/><div class="panel-title"><div><p class="eyebrow">MONTHLY RETENTION</p><h3 id="mission-form-title">Add player mission</h3></div><button id="mission-form-reset" class="ghost-button small" type="button">New</button></div><div class="gm-fields"><label>Name<input name="name" maxlength="120" required/></label><label>Slug<input name="slug" pattern="[a-z0-9][a-z0-9-]{1,49}" required/></label></div><label>Description<textarea name="description" maxlength="500" required></textarea></label><div class="gm-fields"><label>Progress source<select name="metric"><option value="raid_kills">Verified raid kills</option><option value="achievements">Achievements earned</option><option value="honorable_kills">Verified battleground HKs</option><option value="verified_votes">Verified votes</option></select></label><label>Category<select name="category"><option value="pve">PvE</option><option value="pvp">PvP</option><option value="community">Community</option></select></label></div><div class="gm-fields"><label>Monthly target<input name="target" type="number" min="1" max="1000000" value="3" required/></label><label>Reward credits<input name="rewardCredits" type="number" min="1" max="100000" value="10" required/></label></div><div class="gm-fields"><label>Display order<input name="sortOrder" type="number" value="0"/></label><label class="checkbox-field"><input name="active" type="checkbox" checked/> Active</label></div><button class="button" type="submit">Save mission</button><p class="form-message" role="status"></p></form><div id="admin-missions" class="admin-table"><p class="muted">Loading…</p></div></article>
          <article class="account-panel"><form id="gm-download-form"><h3>Add client download</h3><div class="gm-fields"><label>Name<input name="name" maxlength="100" required/></label><label>Platform<input name="platform" maxlength="30" placeholder="Windows" required/></label></div><label>Primary download URL<input name="url" type="url" required/></label><label>Additional mirrors<textarea name="mirrors" rows="3" placeholder="Europe | https://eu.example/client.zip&#10;North America | https://us.example/client.zip"></textarea><small>One label and URL per line, separated by |.</small></label><div class="gm-fields"><label>Version<input name="version" maxlength="40" placeholder="3.3.5a · 12340"/></label><label>File size<input name="fileSize" maxlength="40" placeholder="17 GB"/></label><label>Release date<input name="releasedAt" type="date"/></label></div><label>SHA-256 checksum<input name="sha256" pattern="[a-fA-F0-9]{64}"/></label><div class="gm-fields"><label>Signature URL<input name="signatureUrl" type="url"/></label><label>VirusTotal report URL<input name="virusTotalUrl" type="url"/></label><label>Changelog URL<input name="changelogUrl" type="url"/></label></div><label>System requirements<textarea name="requirements" maxlength="1000" placeholder="Supported operating systems, storage, memory, and graphics requirements"></textarea></label><label>Installation notes<textarea name="notes" maxlength="500"></textarea></label><label>Display order<input name="sortOrder" type="number" value="0"/></label><button class="button" type="submit">Add download</button><p class="form-message"></p></form><div id="admin-downloads" class="admin-table"></div></article>
          <article class="account-panel"><form id="launcher-patch-form"><div class="panel-title"><div><p class="eyebrow">AUTOMATIC UPDATES</p><h3>Add launcher patch</h3></div></div><div class="gm-fields"><label>Platform<input name="platform" maxlength="30" placeholder="Windows" required/></label><label>File size<input name="fileSize" maxlength="40" placeholder="84 MB"/></label></div><div class="gm-fields"><label>From version<input name="fromVersion" maxlength="40" placeholder="1.0.0" required/></label><label>To version<input name="toVersion" maxlength="40" placeholder="1.1.0" required/></label></div><label>Primary patch URL<input name="url" type="url" required/></label><label>Additional mirrors<textarea name="mirrors" rows="3" placeholder="Europe | https://eu.example/patch.zip"></textarea><small>Launchers choose a verified mirror and apply the shortest available version path.</small></label><label>SHA-256 checksum<input name="sha256" pattern="[a-fA-F0-9]{64}" required/></label><div class="gm-fields"><label>Signature URL<input name="signatureUrl" type="url"/></label><label>Release date<input name="releasedAt" type="date"/></label></div><label>Patch notes<textarea name="notes" maxlength="500"></textarea></label><label>Display order<input name="sortOrder" type="number" value="0"/></label><button class="button" type="submit">Publish patch</button><p class="form-message" role="status"></p></form><div id="admin-launcher-patches" class="admin-table"></div></article>
        </div>
        <article class="account-panel cms-panel"><div class="panel-title"><div><p class="eyebrow">MEDIA LIBRARY</p><h3>Managed images</h3><p class="muted">Upload validated images once, then copy their stable URL into news and branding fields.</p></div></div><form id="media-upload-form"><div class="gm-fields"><label>Image<input name="image" type="file" accept="image/png,image/jpeg,image/gif" required/></label><label>Alternative text<input name="alt" maxlength="300" placeholder="Describe the image for players who cannot see it"/></label></div><div id="media-upload-preview" class="media-upload-preview hidden"><img alt="Selected image preview"/><span></span></div><button class="button" type="submit">Upload image</button><p class="form-message"></p></form><div id="admin-media" class="media-library"><p class="muted">Loading media…</p></div></article>
        <article class="account-panel cms-panel"><div class="panel-title"><div><p class="eyebrow">SITE NAVIGATION</p><h3>Header and footer links</h3><p class="muted">Once the first item is saved, this ordered list replaces the built-in links for this realm.</p></div><button id="navigation-reset" class="ghost-button" type="button">New link</button></div><form id="navigation-form"><input name="id" type="hidden"/><div class="gm-fields"><label>Area<select name="area"><option value="primary">Header</option><option value="footer">Footer</option></select></label><label>Label<input name="label" maxlength="80" required/></label></div><div class="gm-fields"><label>URL<input name="url" maxlength="500" placeholder="/play or https://discord.gg/…" required/></label><label>Display order<input name="sortOrder" type="number" min="-10000" max="10000" value="0"/></label></div><div class="feature-switches"><label><input name="newTab" type="checkbox"/> Open in a new tab</label><label><input name="active" type="checkbox" checked/> Active</label></div><button class="button" type="submit">Save link</button><p class="form-message"></p></form><div id="admin-navigation" class="admin-table"><p class="muted">Loading navigation…</p></div></article>
        <article class="account-panel cms-panel"><form id="content-page-form"><input name="id" type="hidden"/><div class="panel-title"><div><p class="eyebrow">CUSTOM PAGES</p><h3 id="content-page-editor-title">New information page</h3></div><button id="content-page-reset" class="ghost-button" type="button">New</button></div><div class="gm-fields"><label>Title<input name="title" maxlength="160" required/></label><label>Slug<input name="slug" maxlength="120" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="rules"/></label></div><label>Summary<textarea name="summary" maxlength="1000" rows="2"></textarea></label><label>Body<textarea name="body" maxlength="100000" rows="10" required></textarea></label><div class="gm-fields"><label>Status<select name="status"><option value="draft">Draft</option><option value="published">Published</option><option value="archived">Archived</option></select></label><label>Display order<input name="sortOrder" type="number" value="0"/></label></div><div class="gm-fields"><label>SEO title<input name="seoTitle" maxlength="160"/></label><label>SEO description<input name="seoDescription" maxlength="300"/></label></div><div class="feature-switches"><label><input name="showNavigation" type="checkbox"/> Show in main navigation</label><label><input name="showFooter" type="checkbox" checked/> Show in footer</label></div><button class="button" type="submit">Save page</button><p class="form-message"></p></form><div id="admin-pages" class="admin-table"></div></article>
        <article class="account-panel cms-panel"><div class="panel-title"><div><p class="eyebrow">COMMUNITY TRIAGE</p><h3>Suggestions and bug reports</h3></div><a class="ghost-button" href="/tracker">Open public tracker</a></div><div class="admin-table-tools"><label>Status<select id="admin-tracker-status"><option value="">Every status</option><option value="open">Open</option><option value="under_review">Under review</option><option value="planned">Planned</option><option value="in_progress">In progress</option><option value="resolved">Resolved</option><option value="closed">Closed</option><option value="declined">Declined</option></select></label><button id="admin-tracker-refresh" class="ghost-button" type="button">Refresh</button></div><div id="admin-community-issues" class="admin-table"><p class="muted">Loading…</p></div><form id="admin-community-issue-form" class="gm-panel hidden"><input name="id" type="hidden"/><div class="panel-title"><h3 id="admin-community-issue-title">Triage submission</h3><button id="admin-community-issue-close" class="ghost-button" type="button">Close</button></div><div class="gm-fields"><label>Status<select name="status"><option value="open">Open</option><option value="under_review">Under review</option><option value="planned">Planned</option><option value="in_progress">In progress</option><option value="resolved">Resolved</option><option value="closed">Closed</option><option value="declined">Declined</option></select></label><label>Priority<select name="priority"><option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option><option value="critical">Critical</option></select></label></div><label>Labels<input name="labels" maxlength="500" placeholder="website, worldserver, accepted"/></label><label>Public staff response<textarea name="staffResponse" maxlength="10000" rows="5"></textarea></label><button class="button" type="submit">Save triage</button><p class="form-message" role="status"></p></form></article>
        <article class="account-panel cms-panel"><div class="panel-title"><div><p class="eyebrow">GUILD RECRUITMENT</p><h3>Recruitment profiles</h3></div><button id="guild-recruitment-reset" class="ghost-button" type="button">New</button></div><form id="guild-recruitment-form"><div class="gm-fields"><label>Guild ID<input name="guildId" type="number" min="1" required/></label><label class="check"><input name="active" type="checkbox" checked/> Accepting applications</label></div><label>Headline<input name="headline" minlength="5" maxlength="160" required/></label><label>Description<textarea name="description" minlength="20" maxlength="10000" rows="5" required></textarea></label><div class="gm-fields"><label>Looking for<input name="lookingFor" maxlength="500" placeholder="Healers, ranged DPS…"/></label><label>Raid schedule<input name="schedule" maxlength="300"/></label></div><div class="gm-fields"><label>Contact instructions<input name="contact" maxlength="300"/></label><label>Guild Discord invite<input name="discordUrl" type="url" maxlength="500" placeholder="https://discord.gg/…"/></label></div><button class="button" type="submit">Save recruitment profile</button><p class="form-message" role="status"></p></form><div id="admin-guild-recruitment" class="admin-table"><p class="muted">Loading…</p></div></article>
      </section>

      <section class="admin-view" data-admin-view="support-admin"><div class="admin-view-head"><div><p class="eyebrow">SUPPORT</p><h2>Player tickets</h2><p>Prioritize, assign, answer, and audit every support request.</p></div><button id="support-refresh" class="ghost-button">Refresh</button></div><div class="admin-table-tools"><label>Search<input id="support-search" type="search" placeholder="Ticket, subject, or account"/></label><label>Status<select id="support-status-filter"><option value="">All statuses</option><option value="pending_staff">Waiting for staff</option><option value="pending_player">Waiting for player</option><option value="open">Open</option><option value="resolved">Resolved</option><option value="closed">Closed</option></select></label><label>Priority<select id="support-priority-filter"><option value="">All priorities</option><option value="urgent">Urgent</option><option value="high">High</option><option value="normal">Normal</option><option value="low">Low</option></select></label></div><div class="admin-dashboard-grid"><article class="account-panel"><div id="admin-tickets" class="admin-table"><p class="muted">Loading…</p></div></article><article class="account-panel"><form id="canned-reply-form"><h3>Canned replies</h3><label>Title<input name="title" maxlength="100" required/></label><label>Reply body<textarea name="body" minlength="2" maxlength="4000" required></textarea></label><button class="button small">Save reply</button><p class="form-message"></p></form><div id="canned-replies" class="admin-table"></div></article></div><article class="account-panel cms-panel"><div class="panel-title"><div><p class="eyebrow">GUILD APPLICATIONS</p><h3>Recruitment inbox</h3></div><div class="row-actions"><select id="guild-application-status" aria-label="Filter guild applications by status"><option value="">Every status</option><option value="submitted">Submitted</option><option value="reviewing">Reviewing</option><option value="accepted">Accepted</option><option value="declined">Declined</option><option value="withdrawn">Withdrawn</option></select><button id="guild-applications-refresh" class="ghost-button" type="button">Refresh</button></div></div><div id="admin-guild-applications" class="admin-table"><p class="muted">Loading…</p></div><form id="guild-application-review" class="gm-panel hidden"><input name="id" type="hidden"/><div class="panel-title"><h3 id="guild-application-review-title">Review application</h3><button id="guild-application-review-close" class="ghost-button" type="button">Close</button></div><label>Status<select name="status"><option value="reviewing">Reviewing</option><option value="accepted">Accepted</option><option value="declined">Declined</option><option value="submitted">Submitted</option></select></label><label>Internal note<textarea name="staffNote" maxlength="2000" rows="4"></textarea></label><button class="button" type="submit">Save decision</button><p class="form-message" role="status"></p></form></article></section>

      <section class="admin-view" data-admin-view="settings"><div class="admin-view-head"><div><p class="eyebrow">CONFIGURATION</p><h2>Website settings</h2></div></div><form id="gm-settings-form" class="gm-panel"><div class="gm-fields"><label>Portal name<input name="portalName" required/></label><label>Realm name<input name="realmName" required/></label></div><div class="gm-fields"><label>Brand mark<input name="brandMark" maxlength="3" required/></label><label>Realm address<input name="realmAddress" required/></label></div><div class="gm-fields"><label>Experience rate<input name="experienceRate" placeholder="2×" maxlength="30" required/></label><span></span></div><label>Tagline<textarea name="tagline" maxlength="500"></textarea></label><div class="gm-fields"><label>Download URL<input name="downloadUrl"/></label><label>Community URL<input name="communityUrl"/></label></div><div class="gm-fields"><label>Terms URL<input name="termsUrl"/></label><label>Privacy URL<input name="privacyUrl"/></label></div><div class="gm-fields"><label>Primary color<input name="themePrimary" type="color"/></label><label>Accent color<input name="themeAccent" type="color"/></label></div><div class="gm-fields"><label>Secondary color<input name="themeSecondary" type="color"/></label><label>Background color<input name="themeBackground" type="color"/></label></div><label class="check"><input name="maintenanceEnabled" type="checkbox"/> Maintenance mode</label><label>Maintenance message<input name="maintenanceMessage" maxlength="500"/></label><div class="gm-fields"><label>Starts<input name="maintenanceStarts" type="datetime-local"/></label><label>Ends<input name="maintenanceEnds" type="datetime-local"/></label></div><fieldset class="feature-switches"><legend>Features</legend><label><input name="registration" type="checkbox"/> Registration</label><label><input name="armory" type="checkbox"/> Armory</label><label><input name="rankings" type="checkbox"/> Rankings</label><label><input name="guilds" type="checkbox"/> Guilds</label><label><input name="realm" type="checkbox"/> Realm status</label><label><input name="shop" type="checkbox"/> Shop</label><label><input name="support" type="checkbox"/> Support</label><label><input name="admin" type="checkbox"/> Admin panel</label><label><input name="gmConsole" type="checkbox"/> GM console</label></fieldset><button class="button" type="submit">Save settings</button><p class="form-message"></p></form></section>

      <section class="admin-view" data-admin-view="staff">
        <div class="admin-view-head"><div><p class="eyebrow">ACCESS CONTROL</p><h2>Staff roles</h2><p>Assign least-privilege portal access independently of AzerothCore GM levels.</p></div></div>
        <div class="admin-dashboard-grid">
          <form id="staff-role-form" class="gm-panel">
            <h3>Assign role</h3>
            <label>Account name<input name="username" maxlength="32" required/></label>
            <label>Role<select name="role"><option value="support">Support</option><option value="shop_manager">Shop manager</option><option value="moderator">Moderator</option><option value="content_manager">Content manager</option><option value="realm_operator">Realm operator</option><option value="administrator">Administrator</option></select></label>
            <label>Realm scope<select name="realmKey"><option value="">This realm</option><option value="*">All realms</option></select></label>
            <label>Access expires <span class="muted">(optional)</span><input name="expiresAt" type="datetime-local"/></label>
            <fieldset><legend>Permission override <span class="muted">(optional)</span></legend><p class="muted">Selecting any permission replaces the role defaults.</p><div class="check-grid">
              <label><input type="checkbox" name="permission" value="overview"/> Overview</label><label><input type="checkbox" name="permission" value="monitoring"/> Monitoring</label><label><input type="checkbox" name="permission" value="players"/> Players</label><label><input type="checkbox" name="permission" value="moderation"/> Moderation</label><label><input type="checkbox" name="permission" value="audit"/> Audit</label><label><input type="checkbox" name="permission" value="commerce"/> Commerce</label><label><input type="checkbox" name="permission" value="content"/> Content</label><label><input type="checkbox" name="permission" value="realm"/> Realm</label><label><input type="checkbox" name="permission" value="settings"/> Settings</label><label><input type="checkbox" name="permission" value="support"/> Support</label><label><input type="checkbox" name="permission" value="console"/> Console</label><label><input type="checkbox" name="permission" value="admin"/> Staff administration</label>
            </div></fieldset>
            <button class="button" type="submit">Save role</button><p class="form-message"></p>
          </form>
          <article class="account-panel"><h3>Explicit assignments</h3><p class="muted">Accounts without an assignment continue to use the configured GM-level fallback.</p><div id="staff-list" class="admin-table"><p class="muted">Loading…</p></div></article>
        </div>
      </section>

      <section class="admin-view" data-admin-view="audit"><div class="admin-view-head"><div><p class="eyebrow">AUDIT</p><h2>Staff activity</h2><p>Every state-changing staff request has a correlation ID. Network identifiers are automatically redacted before the event itself expires.</p></div><button id="audit-export" class="ghost-button">Export complete CSV</button></div><div class="admin-table-tools audit-tools"><label>Search<input id="audit-search" type="search" placeholder="Event ID, target, or reason"/></label><label>Actor<input id="audit-actor" type="search" placeholder="Staff account"/></label><label>Action<input id="audit-action" type="search" placeholder="product.update"/></label><label>Source<select id="audit-source"><option value="">All sources</option><option value="portal">Portal</option><option value="moderation">Moderation</option><option value="console">Console</option><option value="support">Support</option><option value="credits">Credits</option></select></label><label>Status<select id="audit-status"><option value="">All statuses</option><option value="executed">Executed</option><option value="failed">Failed</option><option value="review">Review</option></select></label><label>From<input id="audit-from" type="date"/></label><label>To<input id="audit-to" type="date"/></label></div><div class="saved-filter-bar"><label>Saved filter<select id="audit-saved-filter"><option value="">Choose a filter</option></select></label><label>Save current view as<input id="audit-filter-name" maxlength="80" placeholder="Commerce failures"/></label><button id="audit-filter-save" class="ghost-button" type="button">Save view</button><button id="audit-filter-delete" class="ghost-button" type="button">Delete selected</button></div><article class="account-panel"><div id="moderation-log" class="admin-table"><p class="muted">Loading…</p></div></article></section>
      <section class="admin-view" data-admin-view="privacy"><div class="admin-view-head"><div><p class="eyebrow">PRIVACY</p><h2>Data requests</h2><p>Track deletion and anonymization requests. Complete them only after the portal and game records have been handled.</p></div><button id="privacy-refresh" class="ghost-button">Refresh</button></div><div class="admin-table-tools"><label>Search<input id="privacy-search" type="search" placeholder="Account or player note"/></label><label>Status<select id="privacy-status"><option value="">All statuses</option><option value="pending">Pending</option><option value="processing">Processing</option><option value="completed">Completed</option><option value="rejected">Rejected</option><option value="cancelled">Cancelled</option></select></label><label>Type<select id="privacy-type"><option value="">All types</option><option value="deletion">Deletion</option><option value="anonymization">Anonymization</option></select></label></div><article class="account-panel"><div id="admin-privacy-requests" class="admin-table"><p class="muted">Loading…</p></div></article></section>
    </div>
  </section>
  <dialog id="order-reconcile-dialog" class="admin-dialog">
    <button class="dialog-close" type="button" aria-label="Close">×</button>
    <p class="eyebrow">FULFILLMENT LEDGER</p>
    <h2 id="order-reconcile-title">Order delivery</h2>
    <p class="muted">Completed steps are never replayed. An interrupted executing step must be checked in-game before it is marked completed or retried.</p>
    <div id="order-step-list" class="order-step-list"></div>
    <form id="order-step-form" class="hidden">
      <input name="orderId" type="hidden"/><input name="stepKey" type="hidden"/>
      <label>Resolution<select name="resolution"><option value="retry">Retry this step</option><option value="completed">Already delivered — mark completed</option></select></label>
      <label>Reconciliation reason<textarea name="reason" minlength="3" maxlength="255" required></textarea></label>
      <label>Confirmation<input name="confirmation" required autocomplete="off" placeholder="Type RECONCILE"/></label>
      <div class="row-actions"><button class="button" type="submit">Apply resolution</button><button class="ghost-button" type="button" data-cancel-reconcile>Cancel</button></div>
      <p class="form-message"></p>
    </form>
  </dialog>
  <dialog id="ticket-action-dialog" class="admin-dialog">
    <button class="dialog-close" type="button" aria-label="Close">×</button>
    <p class="eyebrow">SUPPORT TICKET</p><h2 id="ticket-action-title">Reply to ticket</h2><p id="ticket-action-context" class="muted"></p>
    <form id="ticket-action-form"><input name="ticketId" type="hidden"/><div class="gm-fields"><label>Status<select name="status"><option value="pending_staff">Waiting for staff</option><option value="pending_player">Waiting for player</option><option value="resolved">Resolved</option><option value="closed">Closed</option><option value="open">Open</option></select></label><label>Priority<select name="priority"><option value="low">Low · 120h SLA</option><option value="normal">Normal · 72h SLA</option><option value="high">High · 24h SLA</option><option value="urgent">Urgent · 4h SLA</option></select></label></div><div class="gm-fields"><label>Category<select name="category"><option value="general">General</option><option value="account">Account</option><option value="character">Character</option><option value="billing">Shop or billing</option><option value="bug">Bug</option><option value="report">Report</option><option value="appeal">Appeal</option></select></label><label>Assignment<select name="assignment"><option value="keep">Keep current</option><option value="self">Assign to me</option><option value="none">Unassign</option></select></label></div><label>Tags<input name="tags" maxlength="500" placeholder="billing, urgent, investigation"/></label><label>Canned reply<select id="ticket-canned-reply"><option value="">Choose a saved reply…</option></select></label><label>Player-visible response<textarea name="response" maxlength="4000"></textarea></label><label>Internal note<textarea name="internalNote" maxlength="4000" placeholder="Only staff can see this note"></textarea></label><div id="ticket-event-history" class="ticket-event-history"></div><div class="row-actions"><button class="button" type="submit">Save update</button><button class="ghost-button" type="button" data-ticket-cancel>Cancel</button></div><p class="form-message"></p></form>
  </dialog>
  <section id="admin-denied" class="wrap admin-denied hidden"><p class="eyebrow">ACCESS DENIED</p><h1>GM access required</h1><p>This area is restricted to authorized realm staff.</p><a class="button" href="/account">Return to account</a></section>
</Layout>
