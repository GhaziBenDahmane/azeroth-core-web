---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Create account — Azeroth" page="register"><section class="auth-shell wrap"><div class="auth-aside"><p class="eyebrow">JOIN THE REALM</p><h1>BEGIN YOUR<br/><em>LEGEND.</em></h1><p>One account unlocks the realm, armory, and community shop.</p><ul><li>Instant game account</li><li>AzerothCore SRP6 security</li><li>No client download required here</li></ul></div><form id="register-form" class="form-card"><p class="eyebrow">CREATE ACCOUNT</p><h2>Welcome, adventurer</h2><p class="muted">Already registered? <a href="/login">Sign in</a></p><label>Username<input name="username" minlength="3" maxlength="32" pattern="[A-Za-z0-9]+" autocomplete="username" required/><small>Latin letters and numbers, 3–32 characters.</small></label><label>Email<input name="email" type="email" maxlength="255" autocomplete="email" required/></label><label>Password<input name="password" type="password" minlength="8" maxlength="32" autocomplete="new-password" required/><small>8–32 printable characters. The game client is case-insensitive.</small></label><button class="button full" type="submit">Create my account →</button><p class="form-message" aria-live="polite"></p></form></section></Layout>
