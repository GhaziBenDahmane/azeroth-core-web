---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Create account — Azeroth" page="register"><section class="auth-shell wrap"><div class="auth-aside"><p class="eyebrow" data-i18n="register.eyebrow">New account</p><h1 data-i18n="register.title">Join the realm</h1><p data-i18n="register.intro">One account gives you access to the game server, armory, and shop.</p><ul><li data-i18n="register.benefitEmail">Email-linked account</li><li data-i18n="register.benefitSecurity">AzerothCore SRP6 security</li><li data-i18n="register.benefitCharacters">Manage characters from the portal</li></ul></div><form id="register-form" class="form-card"><p class="eyebrow" data-i18n="register.formEyebrow">Registration</p><h2 data-i18n="register.formTitle">Create your account</h2><p class="muted">Already registered? <a href="/login" data-i18n="action.signIn">Sign in</a> · <a href="/verify-email" data-i18n="register.resendVerification">Resend verification</a></p><label><span data-i18n="field.username">Username</span><input name="username" minlength="3" maxlength="32" pattern="[A-Za-z0-9]+" autocomplete="username" required/><small data-i18n="register.usernameHelp">Latin letters and numbers, 3–32 characters.</small></label><label><span data-i18n="field.email">Email</span><input name="email" type="email" maxlength="255" autocomplete="email" required/><small data-i18n="register.emailHelp">We may send an activation link before you can sign in.</small></label><label><span data-i18n="field.password">Password</span><input name="password" type="password" minlength="8" maxlength="32" autocomplete="new-password" required/><small data-i18n="register.passwordHelp">8–32 printable characters. The game client is case-insensitive.</small></label><div id="turnstile"></div><input type="hidden" name="turnstileToken"/><button class="button full" type="submit" data-i18n="action.register">Create account</button><p class="form-message" aria-live="polite"></p></form></section></Layout>
