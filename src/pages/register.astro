---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Create account — Azeroth" page="register"><section class="auth-shell wrap"><div class="auth-aside"><p class="eyebrow">New account</p><h1>Join the realm</h1><p>One account gives you access to the game server, armory, and shop.</p><ul><li>Email-linked account</li><li>AzerothCore SRP6 security</li><li>Manage characters from the portal</li></ul></div><form id="register-form" class="form-card"><p class="eyebrow">Registration</p><h2>Create your account</h2><p class="muted">Already registered? <a href="/login">Sign in</a> · <a href="/verify-email">Resend verification</a></p><label>Username<input name="username" minlength="3" maxlength="32" pattern="[A-Za-z0-9]+" autocomplete="username" required/><small>Latin letters and numbers, 3–32 characters.</small></label><label>Email<input name="email" type="email" maxlength="255" autocomplete="email" required/><small>We may send an activation link before you can sign in.</small></label><label>Password<input name="password" type="password" minlength="8" maxlength="32" autocomplete="new-password" required/><small>8–32 printable characters. The game client is case-insensitive.</small></label><div id="turnstile"></div><input type="hidden" name="turnstileToken"/><button class="button full" type="submit">Create account</button><p class="form-message" aria-live="polite"></p></form></section></Layout>
