---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Choose a password — Azeroth" page="reset-password"><section class="auth-shell wrap compact"><div class="auth-aside"><p class="eyebrow">Account recovery</p><h1>Choose a new password</h1></div><form id="reset-form" class="form-card"><p class="eyebrow">New password</p><h2>Secure your account</h2><label>New password<input name="password" type="password" minlength="8" maxlength="32" autocomplete="new-password" required/></label><button class="button full">Reset password</button><p class="form-message"></p></form></section></Layout>
