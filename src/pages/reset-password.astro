---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Choose a password — Azeroth" page="reset-password"><section class="auth-shell wrap compact"><div class="auth-aside"><p class="eyebrow">ACCOUNT RECOVERY</p><h1>FORGE A NEW<br/><em>KEY.</em></h1></div><form id="reset-form" class="form-card"><p class="eyebrow">NEW PASSWORD</p><h2>Secure your account</h2><label>New password<input name="password" type="password" minlength="8" maxlength="32" autocomplete="new-password" required/></label><button class="button full">Reset password →</button><p class="form-message"></p></form></section></Layout>
