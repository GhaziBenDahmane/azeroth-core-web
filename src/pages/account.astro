---
import Layout from '../layouts/Layout.astro';
---
<Layout title="My account — Azeroth" page="account"><section class="page-hero wrap account-head"><div><p class="eyebrow">COMMAND CENTER</p><h1>Welcome, <em id="account-name">hero</em></h1><p>Characters, balance and recent deliveries.</p></div><button id="logout" class="ghost-button">Sign out</button></section><section class="wrap account-grid"><article class="account-panel"><div class="panel-title"><h2>Your characters</h2><span id="character-count"></span></div><div id="account-characters" class="account-characters"><div class="skeleton"></div></div><form id="gm-credit-form" class="gm-panel hidden"><p class="eyebrow">GM TOOLS</p><h2>Grant account credits</h2><div class="gm-fields"><label>Account<input name="username" placeholder="Account name" maxlength="32" required/></label><label>Credits<input name="amount" type="number" min="1" max="1000000" required/></label></div><label>Audit reason<input name="reason" minlength="3" maxlength="255" placeholder="Event reward, support adjustment…" required/></label><button class="button" type="submit">Grant credits</button><p class="form-message"></p></form></article><aside><article class="balance-card"><p>Portal balance</p><strong><span id="account-balance">—</span> <small>credits</small></strong><a href="/shop">Visit shop →</a></article><article class="account-panel"><h2>Recent orders</h2><div id="orders" class="orders"><p class="muted">Loading…</p></div></article></aside></section></Layout>
