---
import Layout from '../layouts/Layout.astro';
---
<Layout title="My account — Azeroth" page="account">
  <section class="page-hero wrap account-head"><div><p class="eyebrow">COMMAND CENTER</p><h1>Welcome, <em id="account-name">hero</em></h1><p>Characters, balance, deliveries and account protection.</p></div><button id="logout" class="ghost-button">Sign out</button></section>
  <section class="wrap account-grid"><article class="account-panel"><div class="panel-title"><h2>Your characters</h2><span id="character-count"></span></div><p class="muted">Offline characters can be renamed, customized, or moved to their home location.</p><div id="account-characters" class="account-characters"><div class="skeleton"></div></div><h3>Deleted characters</h3><div id="deleted-characters" class="admin-table"><p class="muted">Loading…</p></div></article><aside data-feature-shop><article class="balance-card"><p>Portal balance</p><strong><span id="account-balance">—</span> <small>credits</small></strong><a href="/shop">Get credits or visit shop →</a></article><article class="account-panel"><h2>Recent orders</h2><div id="orders" class="orders"><p class="muted">Loading…</p></div></article></aside></section>
  <section class="wrap account-tools">
    <article class="account-panel security-panel"><p class="eyebrow">ACCOUNT SECURITY</p><h2>Password & authenticator</h2><form id="password-form"><div class="gm-fields"><label>Current password<input name="currentPassword" type="password" required/></label><label>New password<input name="newPassword" type="password" minlength="8" required/></label></div><button class="button small" type="submit">Change password</button><p class="form-message"></p></form><div class="totp-box"><button id="totp-setup" class="ghost-button">Set up authenticator</button><div id="totp-enroll" class="hidden"><p>Enter this secret in your authenticator: <code id="totp-secret"></code></p><form id="totp-form"><label>Six-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" required/></label><button class="button small">Enable 2FA</button><p class="form-message"></p></form></div></div><div data-feature-support><form id="ticket-form" class="gm-panel"><h3>Open a support ticket</h3><label>Subject<input name="subject" minlength="3" maxlength="100" required/></label><label>Message<textarea name="message" minlength="10" maxlength="4000" required></textarea></label><button class="button small" type="submit">Submit ticket</button><p class="form-message"></p></form><h3>Your tickets</h3><div id="my-tickets" class="admin-table"></div></div><h3>Active sessions</h3><div id="security-sessions" class="orders"><p class="muted">Loading…</p></div></article>
    <article id="gm-console" class="account-panel hidden"><p class="eyebrow">GM PANEL</p><h2>Realm administration</h2>
      <form id="gm-account-search" class="gm-panel"><h3>Player lookup</h3><div class="gm-search"><input name="q" placeholder="Account name or email" maxlength="64"/><button class="button" type="submit">Search</button></div><p class="form-message"></p></form><div id="admin-accounts" class="admin-table"></div>
      <form id="gm-moderation-form" class="gm-panel"><h3>Account moderation</h3><div class="gm-fields"><label>Account or character<input name="target" maxlength="32" required/></label><label>Action<select name="action"><option value="ban">Ban account</option><option value="unban">Unban account</option><option value="kick">Kick character</option></select></label></div><label>Duration for bans<input name="duration" value="7d" maxlength="20"/></label><label>Audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Apply moderation action</button><p class="form-message"></p></form>
      <form id="gm-operation-form" class="gm-panel"><h3>Realm operations</h3><div class="gm-fields"><label>Action<select name="action"><option value="start">Start realm</option><option value="mute">Mute character</option><option value="unmute">Unmute character</option><option value="ip_ban">Ban IP</option><option value="ip_unban">Unban IP</option><option value="gm_level">Set GM level</option><option value="announce">Announcement</option><option value="motd">Set MOTD</option><option value="restart">Schedule restart</option><option value="shutdown">Schedule shutdown</option><option value="cancel_shutdown">Cancel shutdown/restart</option></select></label><label>Target<input name="target" placeholder="Character, account, or IP" maxlength="64"/></label></div><div class="gm-fields"><label>Duration / delay<input name="duration" placeholder="Mute minutes or restart seconds" maxlength="20"/></label><label>GM level<input name="level" type="number" min="0" max="3" value="0"/></label></div><label>Realm ID<input name="realmId" type="number" min="-1" value="-1"/></label><label>Message or audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Execute operation</button><p class="form-message"></p></form>
      <section id="gm-command-console" class="gm-panel gm-command-console hidden"><h3>Worldserver console</h3><p class="muted">Commands execute with the configured SOAP account and are permanently audited.</p><form id="gm-command-form"><div class="command-line"><span>&gt;</span><input name="command" maxlength="255" autocomplete="off" spellcheck="false" placeholder="server info" required/><button class="button" type="submit">Run</button></div><p class="form-message"></p></form><pre id="gm-command-output" aria-live="polite">Console ready.</pre><div class="console-policy"><small id="gm-command-policy"></small></div><h3>Recent commands</h3><div id="gm-command-history" class="admin-table"></div></section>
      <form id="gm-credit-form" class="gm-panel"><h3>Grant account credits</h3><div class="gm-fields"><label>Account<input name="username" placeholder="Account name" maxlength="32" required/></label><label>Credits<input name="amount" type="number" min="1" max="1000000" required/></label></div><label>Audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Grant credits</button><p class="form-message"></p></form>
      <section class="gm-panel catalog-manager"><div class="panel-title"><div><h3>Shop catalog</h3><p class="muted">Open a product to edit its complete delivery package.</p></div><button id="catalog-new" class="ghost-button" type="button">New product</button></div><div id="admin-products" class="admin-table"></div>
        <form id="catalog-editor" class="catalog-editor hidden"><input name="id" type="hidden"/><div class="panel-title"><h3 id="catalog-editor-title">New product</h3><label class="check"><input name="active" type="checkbox" checked/> Active</label></div><div class="gm-fields"><label>Name<input name="name" maxlength="100" required/></label><label>Credit price<input name="price" type="number" min="1" max="10000000" required/></label></div><div class="gm-fields"><label>Category<input name="category" value="Items" maxlength="40" required/></label><label>Class restriction<select name="classId"><option value="0">Any class</option><option value="1">Warrior</option><option value="2">Paladin</option><option value="3">Hunter</option><option value="4">Rogue</option><option value="5">Priest</option><option value="6">Death Knight</option><option value="7">Shaman</option><option value="8">Mage</option><option value="9">Warlock</option><option value="11">Druid</option></select></label></div><div class="gm-fields"><label>Tier / label<input name="tier" maxlength="30"/></label><label>Level service<input name="serviceLevel" type="number" min="0" max="80" value="0"/></label></div><div class="gm-fields"><label>Gold amount<input name="gold" type="number" min="0" max="200000" value="0"/><small>Gold delivered with this package.</small></label><label>Character service<select name="serviceAction"><option value="">None</option><option value="race_change">Race change</option><option value="faction_change">Faction change</option></select></label></div><label>Description<textarea name="description" maxlength="500"></textarea></label><label>Card image URL<input name="imageUrl" maxlength="500"/></label><div class="gm-fields"><label>Available from<input name="startsAt" type="datetime-local"/></label><label>Available until<input name="endsAt" type="datetime-local"/></label></div><label>Purchases per account (0 unlimited)<input name="perAccountLimit" type="number" min="0" max="100000" value="0"/></label>
          <div class="catalog-item-picker"><label>Find WotLK items, equipment, consumables, or bags<input id="catalog-item-search" type="search" placeholder="Type an item name or ID" autocomplete="off"/></label><div id="catalog-item-results" class="item-search-results"></div></div><div class="catalog-preview"><div><p class="eyebrow">EQUIPMENT PREVIEW</p><div id="catalog-equipment" class="catalog-equipment"></div></div><div><p class="eyebrow">PACKAGE CONTENTS</p><div id="catalog-items" class="catalog-items"></div></div></div><p class="muted">Bags are regular bundle items—search for a bag and set its quantity. Items are delivered unmodified; gems and enchant scrolls must be applied in game.</p><div class="row-actions"><button class="button" type="submit">Save product</button><button id="catalog-archive" class="ghost-button hidden" type="button">Archive</button><button id="catalog-cancel" class="ghost-button" type="button">Close</button></div><p class="form-message"></p></form>
      </section>
      <form id="gm-coupon-form" class="gm-panel"><h3>Create coupon</h3><div class="gm-fields"><label>Code<input name="code" pattern="[A-Za-z0-9_-]{3,40}" required/></label><label>Percent off<input name="discountPercent" type="number" min="0" max="100" value="10"/></label></div><div class="gm-fields"><label>Fixed credits off<input name="discountCredits" type="number" min="0" value="0"/></label><label>Total uses (0 unlimited)<input name="maxUses" type="number" min="0" value="0"/></label></div><div class="gm-fields"><label>Starts<input name="startsAt" type="datetime-local"/></label><label>Ends<input name="endsAt" type="datetime-local"/></label></div><label>Uses per account<input name="perAccountLimit" type="number" min="1" value="1"/></label><button class="button" type="submit">Create coupon</button><p class="form-message"></p></form><div id="admin-coupons" class="admin-table"></div>
      <form id="gm-news-form" class="gm-panel"><h3>Publish news or announcement</h3><div class="gm-fields"><label>Title<input name="title" maxlength="120" required/></label><label>Type<select name="kind"><option value="news">News</option><option value="announcement">Announcement</option><option value="maintenance">Maintenance</option></select></label></div><label>Summary<textarea name="summary" maxlength="1000"></textarea></label><label>Link<input name="url" maxlength="500"/></label><div class="gm-fields"><label>Publish at<input name="publishAt" type="datetime-local"/></label><label>Expires at<input name="expiresAt" type="datetime-local"/></label></div><input name="active" type="hidden" value="true"/><button class="button" type="submit">Publish</button><p class="form-message"></p></form><div id="admin-news" class="admin-table"></div>
      <form id="gm-settings-form" class="gm-panel"><h3>Website configuration</h3><div class="gm-fields"><label>Portal name<input name="portalName" required/></label><label>Realm name<input name="realmName" required/></label></div><div class="gm-fields"><label>Brand mark<input name="brandMark" maxlength="3" required/></label><label>Realm address<input name="realmAddress" required/></label></div><label>Tagline<textarea name="tagline" maxlength="500"></textarea></label><div class="gm-fields"><label>Download URL<input name="downloadUrl"/></label><label>Community URL<input name="communityUrl"/></label></div><div class="gm-fields"><label>Terms URL<input name="termsUrl"/></label><label>Privacy URL<input name="privacyUrl"/></label></div><div class="gm-fields"><label>Primary color<input name="themePrimary" type="color"/></label><label>Accent color<input name="themeAccent" type="color"/></label></div><div class="gm-fields"><label>Secondary color<input name="themeSecondary" type="color"/></label><label>Background color<input name="themeBackground" type="color"/></label></div><label class="check"><input name="maintenanceEnabled" type="checkbox"/> Maintenance mode</label><label>Maintenance message<input name="maintenanceMessage" maxlength="500"/></label><div class="gm-fields"><label>Starts<input name="maintenanceStarts" type="datetime-local"/></label><label>Ends<input name="maintenanceEnds" type="datetime-local"/></label></div><fieldset class="feature-switches"><legend>Features</legend><label><input name="registration" type="checkbox"/> Registration</label><label><input name="armory" type="checkbox"/> Armory</label><label><input name="rankings" type="checkbox"/> Rankings</label><label><input name="guilds" type="checkbox"/> Guilds</label><label><input name="realm" type="checkbox"/> Realm status</label><label><input name="shop" type="checkbox"/> Shop</label><label><input name="support" type="checkbox"/> Support</label><label><input name="admin" type="checkbox"/> Admin panel</label><label><input name="gmConsole" type="checkbox"/> GM console</label></fieldset><button class="button" type="submit">Save website settings</button><p class="form-message"></p></form>
      <h3>Support tickets</h3><div id="admin-tickets" class="admin-table"></div><h3>Moderation log</h3><div id="moderation-log" class="admin-table"><p class="muted">No moderation actions yet.</p></div><h3>Delivery queue</h3><div id="admin-orders" class="admin-table"><p class="muted">Loading…</p></div><h3>Credit ledger</h3><div id="credit-ledger" class="admin-table"></div>
    </article>
  </section>
</Layout>
