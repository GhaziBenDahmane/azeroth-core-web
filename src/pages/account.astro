---
import Layout from '../layouts/Layout.astro';
---
<Layout title="My account — Azeroth" page="account">
  <section class="page-hero wrap account-head"><div><p class="eyebrow">COMMAND CENTER</p><h1>Welcome, <em id="account-name">hero</em></h1><p>Characters, balance, deliveries and account protection.</p></div><button id="logout" class="ghost-button">Sign out</button></section>
  <section class="wrap account-grid"><article class="account-panel"><div class="panel-title"><h2>Your characters</h2><span id="character-count"></span></div><p class="muted">Offline characters can be renamed, customized, or moved to their home location.</p><div id="account-characters" class="account-characters"><div class="skeleton"></div></div><h3>Deleted characters</h3><div id="deleted-characters" class="admin-table"><p class="muted">Loading…</p></div></article><aside data-feature-shop><article class="balance-card"><p>Portal balance</p><strong><span id="account-balance">—</span> <small>credits</small></strong><a href="/shop">Get credits or visit shop →</a></article><article class="account-panel"><h2>Recent orders</h2><div id="orders" class="orders"><p class="muted">Loading…</p></div></article></aside></section>
  <section class="wrap account-tools">
    <article class="account-panel security-panel"><p class="eyebrow">ACCOUNT SECURITY</p><h2>Password & authenticator</h2><form id="password-form"><div class="gm-fields"><label>Current password<input name="currentPassword" type="password" required/></label><label>New password<input name="newPassword" type="password" minlength="8" required/></label></div><button class="button small" type="submit">Change password</button><p class="form-message"></p></form><div class="totp-box"><button id="totp-setup" class="ghost-button">Set up authenticator</button><div id="totp-enroll" class="hidden"><p>Enter this secret in your authenticator: <code id="totp-secret"></code></p><form id="totp-form"><label>Six-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" required/></label><button class="button small">Enable 2FA</button><p class="form-message"></p></form></div></div><div data-feature-support><form id="ticket-form" class="gm-panel"><h3>Open a support ticket</h3><label>Subject<input name="subject" minlength="3" maxlength="100" required/></label><label>Message<textarea name="message" minlength="10" maxlength="4000" required></textarea></label><button class="button small" type="submit">Submit ticket</button><p class="form-message"></p></form><h3>Your tickets</h3><div id="my-tickets" class="admin-table"></div></div><h3>Active sessions</h3><div id="security-sessions" class="orders"><p class="muted">Loading…</p></div></article>
  </section>
</Layout>
