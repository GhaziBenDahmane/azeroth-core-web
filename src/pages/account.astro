---
import Layout from '../layouts/Layout.astro';
---
<Layout title="My account — Azeroth" page="account">
  <section class="page-hero wrap account-head">
    <div><p class="eyebrow">MY ACCOUNT</p><h1>Welcome, <em id="account-name">player</em></h1><p>Manage your characters, purchases, rewards, support, and security. <span id="staff-role" class="staff-role hidden"></span></p></div>
    <button id="logout" class="ghost-button">Sign out</button>
  </section>
  <div class="wrap account-shell">
    <nav class="account-nav" aria-label="Account sections">
      <a href="/account" data-account-route="overview" data-i18n="account.overview">Overview</a>
      <a href="/account/characters" data-account-route="characters" data-i18n="account.characters">Characters</a>
      <a href="/account/transfers" data-account-route="transfers" data-i18n="account.transfers">Transfers</a>
      <a href="/account/orders" data-account-route="orders" data-i18n="account.orders">Orders & wallet</a>
      <a href="/account/rewards" data-account-route="rewards" data-i18n="account.rewards">Rewards</a>
      <a href="/account/notifications" data-account-route="notifications"><span data-i18n="account.notifications">Notifications</span> <span id="account-notification-badge" class="notification-badge hidden">0</span></a>
      <a href="/account/support" data-account-route="support" data-feature-support data-i18n="account.support">Support</a>
      <a href="/account/security" data-account-route="security" data-i18n="account.security">Security</a>
    </nav>
    <div class="account-workspace">
      <section class="account-view" data-account-view="overview">
        <div class="view-heading"><div><p class="eyebrow">OVERVIEW</p><h2>Your realm account</h2></div></div>
        <div class="account-grid overview-grid"><article class="account-panel"><div class="panel-title"><h2>Characters</h2><span id="character-count"></span></div><p class="muted">Your roster on the selected realm.</p><div id="account-character-summary" class="summary-list"><p class="muted">Loading…</p></div><a class="text-action" href="/account/characters">Manage characters →</a></article><aside data-feature-shop><article class="balance-card"><p>Portal balance</p><strong><span id="account-balance">—</span> <small>credits</small></strong><a href="/account/orders">View wallet activity →</a></article></aside></div>
        <div class="admin-dashboard-grid"><article class="account-panel"><h2>Recent account activity</h2><div id="account-activity" class="admin-table"><p class="muted">Loading…</p></div></article><article class="account-panel"><h2>Recent services</h2><div id="service-history" class="admin-table"><p class="muted">Loading…</p></div></article></div>
      </section>
      <section class="account-view" data-account-view="characters">
        <div class="view-heading"><div><p class="eyebrow">CHARACTERS</p><h2>Your roster</h2><p>Inspect characters or request services while they are offline.</p></div></div>
        <article class="account-panel"><div id="account-characters" class="account-characters"><div class="skeleton"></div></div><h3>Deleted characters</h3><div id="deleted-characters" class="admin-table"><p class="muted">Loading…</p></div></article>
      </section>
      <section class="account-view" data-account-view="orders">
        <div class="view-heading"><div><p class="eyebrow">ORDERS & WALLET</p><h2>Credit activity</h2><p>Review purchases, grants, refunds, and reward credits.</p></div><a class="button small" href="/shop">Visit shop</a></div>
        <div class="admin-dashboard-grid"><article class="account-panel"><h2>Recent orders</h2><div id="orders" class="orders"><p class="muted">Loading…</p></div></article><article class="account-panel"><h2>Wallet history</h2><div id="wallet-history" class="admin-table"><p class="muted">Loading…</p></div></article></div>
      </section>
      <section class="account-view" data-account-view="transfers">
        <div class="view-heading"><div><p class="eyebrow">CHARACTER TRANSFERS</p><h2>Bring a character</h2><p>Submit proof from another realm for staff review. Requests never import data automatically.</p></div></div>
        <p id="transfer-sla" class="notice-inline">Transfer requests are reviewed by realm staff.</p><div class="admin-dashboard-grid"><form id="transfer-form" class="gm-panel"><label>Source realm<input name="sourceRealm" maxlength="120" required/></label><label>Character name<input name="characterName" maxlength="32" required/></label><label>Public profile or proof URL<input name="sourceProfileUrl" type="url" maxlength="500"/></label><label>Additional details<textarea name="playerNote" maxlength="1000"></textarea></label><button class="button small" type="submit">Submit for review</button><p class="form-message"></p></form><article class="account-panel"><h3>Your transfer requests</h3><div id="transfer-requests" class="admin-table"><p class="muted">Loading…</p></div></article></div><article class="account-panel"><div class="panel-title"><div><h3>Your guild applications</h3><p class="muted">Applications submitted through recruiting guild profiles.</p></div><a class="ghost-button" href="/guilds">Browse guilds</a></div><div id="my-guild-applications" class="admin-table"><p class="muted">Loading…</p></div></article>
      </section>
      <section class="account-view" data-account-view="rewards">
        <div class="view-heading"><div><p class="eyebrow">REWARDS</p><h2>Earn portal credits</h2></div></div>
        <div class="dashboard-benefits"><article class="account-panel"><h3>Daily reward cycle</h3><p id="daily-reward-copy" class="muted">Loading…</p><div id="daily-reward-cycle" class="reward-cycle" aria-label="Seven-day reward cycle"></div><button id="claim-daily" class="button small" disabled>Claim reward</button></article><article class="account-panel"><h3>Loyalty level</h3><p id="loyalty-level" class="loyalty-level">Loading…</p><p id="loyalty-copy" class="muted"></p><div class="meter"><span id="loyalty-meter"></span></div><small>Points: account days + 3 per daily claim + 5 per verified vote + 10 per recruit.</small></article><article class="account-panel"><h3>Your referral code</h3><button id="referral-code" class="code-copy" data-copy=""><code>Loading…</code><span>Copy</span></button><p id="referral-stats" class="muted"></p><div class="row-actions"><button id="share-referral" class="ghost-button small" type="button">Share invite</button></div></article><article id="vote-reward" class="account-panel hidden"><h3>Vote for the realm</h3><p id="vote-reward-copy" class="muted"></p><a id="vote-link" class="button small" target="_blank" rel="noreferrer">Vote now</a></article></div>
        <article class="account-panel mission-panel"><div class="panel-title"><div><p class="eyebrow">MONTHLY OBJECTIVES</p><h3>PvE, PvP, and community missions</h3><p class="muted">Progress resets each calendar month. Competitive progress only uses verified realm telemetry.</p></div><span id="mission-period" class="status-pending"></span></div><div id="player-missions" class="mission-grid"><p class="muted">Loading…</p></div></article>
        <div class="admin-dashboard-grid"><article class="account-panel"><h3>Referral milestones</h3><div id="referral-milestones" class="reward-milestones"><p class="muted">Loading…</p></div></article><article class="account-panel"><h3>Recent recruits</h3><div id="referral-activity" class="admin-table"><p class="muted">Loading…</p></div></article></div>
      </section>
      <section class="account-view" data-account-view="support" data-feature-support>
        <div class="view-heading"><div><p class="eyebrow">SUPPORT</p><h2>Get help</h2><p>Open a ticket and follow staff responses.</p></div></div>
        <div class="admin-dashboard-grid"><form id="ticket-form" class="gm-panel"><h3>Open a support ticket</h3><label>Category<select name="category"><option value="general">General help</option><option value="account">Account</option><option value="character">Character</option><option value="billing">Shop or billing</option><option value="bug">Bug report</option><option value="report">Player report</option><option value="appeal">Appeal</option></select></label><label>Subject<input name="subject" minlength="3" maxlength="100" required/></label><label>Message<textarea name="message" minlength="10" maxlength="4000" required></textarea></label><button class="button small" type="submit">Submit ticket</button><p class="form-message"></p></form><article class="account-panel"><h3>Your tickets</h3><div id="my-tickets" class="admin-table"><p class="muted">Loading…</p></div></article></div>
        <article class="account-panel"><div class="panel-title"><div><p class="eyebrow">ACCOUNT STANDING</p><h3>Sanctions and appeals</h3></div></div><p class="muted">Sanction history is private. Each sanction accepts one structured appeal.</p><div id="player-sanctions" class="admin-table"><p class="muted">Loading…</p></div></article>
      </section>
      <section class="account-view" data-account-view="notifications">
        <div class="view-heading"><div><p class="eyebrow">NOTIFICATIONS</p><h2>Your inbox</h2><p>Delivery, support, maintenance, and reward updates.</p></div><button id="notifications-read-all" class="ghost-button">Mark all read</button></div>
        <article class="account-panel"><div id="notification-list" class="notification-list"><p class="muted">Loading…</p></div></article>
      </section>
      <section class="account-view" data-account-view="security">
        <div class="view-heading"><div><p class="eyebrow">SECURITY</p><h2>Protect your account</h2><p>Update credentials, enroll an authenticator, and review active sessions.</p></div></div>
        <div class="admin-dashboard-grid"><article class="account-panel security-panel"><h3>Change password</h3><form id="password-form"><label>Current password<input name="currentPassword" type="password" autocomplete="current-password" required/></label><label>New password<input name="newPassword" type="password" autocomplete="new-password" minlength="8" required/></label><button class="button small" type="submit">Change password</button><p class="form-message"></p></form></article><article class="account-panel security-panel"><h3>Change email</h3><p class="muted">The current address remains active until you verify the new one.</p><form id="email-form"><label>New email<input name="email" type="email" autocomplete="email" required/></label><label>Current password<input name="currentPassword" type="password" autocomplete="current-password" required/></label><button class="button small" type="submit">Send verification</button><p class="form-message"></p></form></article><article class="account-panel security-panel"><h3>Authenticator</h3><p id="totp-status" class="muted">Checking authenticator status…</p><button id="totp-setup" class="ghost-button">Set up authenticator</button><div id="totp-enroll" class="hidden"><p>Enter this secret in your authenticator: <code id="totp-secret"></code></p><form id="totp-form"><label>Six-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" required/></label><button class="button small">Enable 2FA</button><p class="form-message"></p></form></div><div id="totp-recovery" class="hidden" role="status"><h4>Save these recovery codes now</h4><p class="muted">Each code works once. They cannot be shown again.</p><pre id="totp-recovery-codes"></pre></div><form id="totp-disable-form" class="hidden"><label>Authenticator or recovery code<input name="code" autocomplete="one-time-code" required/></label><button class="danger-button small" type="submit">Disable authenticator</button><p class="form-message"></p></form></article></div>
        <div class="admin-dashboard-grid identity-grid">
          <article class="account-panel"><div class="panel-title"><div><h3>Game accounts</h3><p class="muted">Master account: <strong id="identity-name">Loading…</strong></p></div></div><p class="muted">Switch between linked AzerothCore accounts without signing in again. Characters, wallet balance, orders, and security settings belong to the active game account.</p><div id="identity-accounts" class="admin-table" aria-live="polite"><p class="muted">Loading…</p></div><div id="identity-providers" class="identity-providers hidden" data-social-oauth><h4>Connected sign-in methods</h4><div id="identity-provider-list"></div><div class="row-actions"><button id="discord-link" class="ghost-button hidden" data-discord-oauth type="button">Connect Discord</button><button id="google-link" class="ghost-button hidden" data-google-oauth type="button">Connect Google</button></div></div></article>
          <form id="identity-link-form" class="account-panel security-panel"><h3>Link an existing game account</h3><p class="muted">You will confirm the active account first. Enter the other account’s credentials below.</p><label>Game account username<input name="username" autocomplete="username" required maxlength="32"/></label><label>Password<input name="password" type="password" autocomplete="current-password" required/></label><label>Authenticator or recovery code <small>(when enabled)</small><input name="code" autocomplete="one-time-code" inputmode="numeric"/></label><label>Display label <small>(optional)</small><input name="label" maxlength="100" placeholder="Raiding account"/></label><button class="button small" type="submit">Link game account</button><p class="form-message"></p></form>
        </div>
        <article class="account-panel hidden" data-passkeys><div class="panel-title"><div><h3>Passkeys</h3><p class="muted">Use a device passkey for phishing-resistant sign-in to this master account.</p></div><button id="passkey-register" class="button small" type="button">Add passkey</button></div><div id="passkey-list" class="admin-table" aria-live="polite"><p class="muted">Loading…</p></div></article>
        <article class="account-panel"><h3>Active sessions</h3><div id="security-sessions" class="orders"><p class="muted">Loading…</p></div></article>
        <article class="account-panel"><div class="panel-title"><div><h3>Your data and privacy</h3><p class="muted">Download a portable account export or request reviewed deletion and anonymization.</p></div><a class="ghost-button" href="/api/privacy/export" download>Download my data</a></div><form id="privacy-deletion-form"><label>Optional note<textarea name="note" maxlength="500"></textarea></label><label>Type DELETE to request deletion<input name="confirmation" autocomplete="off" required/></label><button class="danger-button small" type="submit">Request account deletion</button><p class="form-message"></p></form><div id="privacy-requests" class="admin-table"></div></article>
      </section>
    </div>
  </div>
</Layout>
