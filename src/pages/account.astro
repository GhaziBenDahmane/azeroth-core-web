---
import Layout from '../layouts/Layout.astro';
---
<Layout title="My account — Azeroth" page="account"><section class="page-hero wrap account-head"><div><p class="eyebrow">COMMAND CENTER</p><h1>Welcome, <em id="account-name">hero</em></h1><p>Characters, balance, deliveries and account protection.</p></div><button id="logout" class="ghost-button">Sign out</button></section><section class="wrap account-grid"><article class="account-panel"><div class="panel-title"><h2>Your characters</h2><span id="character-count"></span></div><div id="account-characters" class="account-characters"><div class="skeleton"></div></div></article><aside><article class="balance-card"><p>Portal balance</p><strong><span id="account-balance">—</span> <small>credits</small></strong><a href="/shop">Get credits or visit shop →</a></article><article class="account-panel"><h2>Recent orders</h2><div id="orders" class="orders"><p class="muted">Loading…</p></div></article></aside></section><section class="wrap account-tools"><article class="account-panel security-panel"><p class="eyebrow">ACCOUNT SECURITY</p><h2>Password & authenticator</h2><form id="password-form"><div class="gm-fields"><label>Current password<input name="currentPassword" type="password" required/></label><label>New password<input name="newPassword" type="password" minlength="8" required/></label></div><button class="button small" type="submit">Change password</button><p class="form-message"></p></form><div class="totp-box"><button id="totp-setup" class="ghost-button">Set up authenticator</button><div id="totp-enroll" class="hidden"><p>Enter this secret in your authenticator: <code id="totp-secret"></code></p><form id="totp-form"><label>Six-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" required/></label><button class="button small">Enable 2FA</button><p class="form-message"></p></form></div></div><h3>Active sessions</h3><div id="security-sessions" class="orders"><p class="muted">Loading…</p></div></article><article id="gm-console" class="account-panel hidden"><p class="eyebrow">GM CONSOLE</p><h2>Realm administration</h2><form id="gm-credit-form" class="gm-panel"><h3>Grant account credits</h3><div class="gm-fields"><label>Account<input name="username" placeholder="Account name" maxlength="32" required/></label><label>Credits<input name="amount" type="number" min="1" max="1000000" required/></label></div><label>Audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Grant credits</button><p class="form-message"></p></form><form id="gm-product-form" class="gm-panel"><h3>Add shop item</h3><div class="gm-fields"><label>Name<input name="name" maxlength="100" required/></label><label>Price<input name="price" type="number" min="1" required/></label></div><div class="gm-fields"><label>Item ID<input name="itemId" type="number" min="1" required/></label><label>Quantity<input name="quantity" type="number" min="1" value="1" required/></label></div><label>Category<input name="category" value="Items" maxlength="40" required/></label><label>Description<input name="description" maxlength="500"/></label><button class="button" type="submit">Add product</button><p class="form-message"></p></form><h3>Delivery queue</h3><div id="admin-orders" class="admin-table"><p class="muted">Loading…</p></div><h3>Credit ledger</h3><div id="credit-ledger" class="admin-table"></div></article></section></Layout>
