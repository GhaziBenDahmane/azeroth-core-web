---
import Layout from '../layouts/Layout.astro';
---
<Layout title="My account — Azeroth" page="account">
  <section class="page-hero wrap account-head"><div><p class="eyebrow">COMMAND CENTER</p><h1>Welcome, <em id="account-name">hero</em></h1><p>Characters, balance, deliveries and account protection.</p></div><button id="logout" class="ghost-button">Sign out</button></section>
  <section class="wrap account-grid"><article class="account-panel"><div class="panel-title"><h2>Your characters</h2><span id="character-count"></span></div><div id="account-characters" class="account-characters"><div class="skeleton"></div></div></article><aside><article class="balance-card"><p>Portal balance</p><strong><span id="account-balance">—</span> <small>credits</small></strong><a href="/shop">Get credits or visit shop →</a></article><article class="account-panel"><h2>Recent orders</h2><div id="orders" class="orders"><p class="muted">Loading…</p></div></article></aside></section>
  <section class="wrap account-tools">
    <article class="account-panel security-panel"><p class="eyebrow">ACCOUNT SECURITY</p><h2>Password & authenticator</h2><form id="password-form"><div class="gm-fields"><label>Current password<input name="currentPassword" type="password" required/></label><label>New password<input name="newPassword" type="password" minlength="8" required/></label></div><button class="button small" type="submit">Change password</button><p class="form-message"></p></form><div class="totp-box"><button id="totp-setup" class="ghost-button">Set up authenticator</button><div id="totp-enroll" class="hidden"><p>Enter this secret in your authenticator: <code id="totp-secret"></code></p><form id="totp-form"><label>Six-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" required/></label><button class="button small">Enable 2FA</button><p class="form-message"></p></form></div></div><form id="ticket-form" class="gm-panel"><h3>Open a support ticket</h3><label>Subject<input name="subject" minlength="3" maxlength="100" required/></label><label>Message<textarea name="message" minlength="10" maxlength="4000" required></textarea></label><button class="button small" type="submit">Submit ticket</button><p class="form-message"></p></form><h3>Your tickets</h3><div id="my-tickets" class="admin-table"></div><h3>Active sessions</h3><div id="security-sessions" class="orders"><p class="muted">Loading…</p></div></article>
    <article id="gm-console" class="account-panel hidden"><p class="eyebrow">GM PANEL</p><h2>Realm administration</h2>
      <form id="gm-account-search" class="gm-panel"><h3>Player lookup</h3><div class="gm-search"><input name="q" placeholder="Account name or email" maxlength="64"/><button class="button" type="submit">Search</button></div><p class="form-message"></p></form><div id="admin-accounts" class="admin-table"></div>
      <form id="gm-moderation-form" class="gm-panel"><h3>Account moderation</h3><div class="gm-fields"><label>Account or character<input name="target" maxlength="32" required/></label><label>Action<select name="action"><option value="ban">Ban account</option><option value="unban">Unban account</option><option value="kick">Kick character</option></select></label></div><label>Duration for bans<input name="duration" value="7d" maxlength="20"/></label><label>Audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Apply moderation action</button><p class="form-message"></p></form>
      <form id="gm-operation-form" class="gm-panel"><h3>Realm operations</h3><div class="gm-fields"><label>Action<select name="action"><option value="mute">Mute character</option><option value="unmute">Unmute character</option><option value="ip_ban">Ban IP</option><option value="ip_unban">Unban IP</option><option value="gm_level">Set GM level</option><option value="announce">Announcement</option><option value="motd">Set MOTD</option><option value="restart">Schedule restart</option><option value="shutdown">Schedule shutdown</option><option value="cancel_shutdown">Cancel shutdown/restart</option></select></label><label>Target<input name="target" placeholder="Character, account, or IP" maxlength="64"/></label></div><div class="gm-fields"><label>Duration / delay<input name="duration" placeholder="Mute minutes or restart seconds" maxlength="20"/></label><label>GM level<input name="level" type="number" min="0" max="3" value="0"/></label></div><label>Realm ID<input name="realmId" type="number" min="-1" value="-1"/></label><label>Message or audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Execute operation</button><p class="form-message"></p></form>
      <form id="gm-credit-form" class="gm-panel"><h3>Grant account credits</h3><div class="gm-fields"><label>Account<input name="username" placeholder="Account name" maxlength="32" required/></label><label>Credits<input name="amount" type="number" min="1" max="1000000" required/></label></div><label>Audit reason<input name="reason" minlength="3" maxlength="255" required/></label><button class="button" type="submit">Grant credits</button><p class="form-message"></p></form>
      <form id="gm-product-form" class="gm-panel"><h3>Add shop item</h3><div class="gm-fields"><label>Name<input name="name" maxlength="100" required/></label><label>Price<input name="price" type="number" min="1" required/></label></div><div class="gm-fields"><label>Item ID<input name="itemId" type="number" min="1" required/></label><label>Quantity<input name="quantity" type="number" min="1" value="1" required/></label></div><label>Category<input name="category" value="Items" maxlength="40" required/></label><label>Description<input name="description" maxlength="500"/></label><button class="button" type="submit">Add product</button><p class="form-message"></p></form>
      <h3>Support tickets</h3><div id="admin-tickets" class="admin-table"></div><h3>Moderation log</h3><div id="moderation-log" class="admin-table"><p class="muted">No moderation actions yet.</p></div><h3>Delivery queue</h3><div id="admin-orders" class="admin-table"><p class="muted">Loading…</p></div><h3>Credit ledger</h3><div id="credit-ledger" class="admin-table"></div>
    </article>
  </section>
</Layout>
