---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Azeroth" page="not-found">
  <section class="page-hero wrap not-found-page">
    <p class="eyebrow">404 · LOST IN NORTHREND</p>
    <h1>This path has gone cold.</h1>
    <p>The page may have moved, or the portal feature may not be enabled for this realm.</p>
    <div class="hero-actions"><a class="button" href="/">Return home</a><a class="ghost-button" href="/account">Open my account</a></div>
  </section>
</Layout>
