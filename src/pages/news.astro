---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Realm news — Azeroth" page="news">
  <section class="page-hero wrap"><p class="eyebrow">REALM JOURNAL</p><h1 id="news-page-title">News and announcements</h1><p id="news-page-intro">Updates, maintenance notices, events, and stories from the realm.</p></section>
  <section class="wrap content-section">
    <div id="news-index" class="news-grid"><div class="skeleton"></div></div>
    <article id="news-article" class="published-article hidden"></article>
  </section>
</Layout>
