---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Shop — Azeroth" page="shop"><section class="page-hero wrap"><p class="eyebrow">COMMUNITY SHOP</p><h1>Equip your <em>adventure</em></h1><p>Support the realm and receive purchases safely through in-game mail.</p><div id="shop-meta" class="shop-meta"></div></section><section class="wrap content-section"><div id="shop-filters" class="filters"></div><div id="product-grid" class="product-grid loading-grid"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div></section><dialog id="purchase-dialog"><button class="dialog-close" aria-label="Close">×</button><p class="eyebrow">CONFIRM ORDER</p><h2 id="purchase-title">Purchase</h2><p>Choose an offline character. Delivery arrives in their in-game mailbox.</p><label>Character<select id="purchase-character"></select></label><div class="order-total"><span>Total</span><strong id="purchase-price"></strong></div><button id="purchase-confirm" class="button full">Send item →</button><p class="form-message"></p></dialog></Layout>
