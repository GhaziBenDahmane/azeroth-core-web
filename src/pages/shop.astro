---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Shop — Azeroth" page="shop">
  <section class="page-hero wrap">
    <p class="eyebrow" data-i18n="shop.eyebrow">Realm store</p><h1 data-i18n="shop.title">Shop</h1>
    <p data-i18n="shop.intro">Browse available items and receive purchases safely through the delivery queue.</p>
    <div id="shop-meta" class="shop-meta"></div>
  </section>
  <details class="wrap credit-store">
    <summary><span><small data-i18n="shop.walletEyebrow">Portal wallet</small><b data-i18n="shop.walletTitle">Purchase or gift credits</b></span><span class="wallet-summary-action" data-i18n="shop.walletOpen">Open wallet ↓</span></summary>
    <div class="credit-store-content"><div><p>Payments are verified server-side before credits reach your wallet.</p><small>Credit purchases never deliver game items directly; catalog orders use the audited delivery queue.</small></div><div class="credit-packages"><button data-credit-package="small"><b>100</b><span>credits</span></button><button data-credit-package="medium"><b>550</b><span>credits</span></button><button data-credit-package="large"><b>1,200</b><span>credits</span></button></div></div>
  </details>
  <section class="wrap content-section">
    <div id="shop-collections" class="shop-collections hidden"></div>
    <div class="shop-discovery" aria-label="Find shop products">
      <label><span data-i18n="shop.search">Search products</span><input id="shop-search" type="search" placeholder="Name, category, class, season, or item" data-i18n-placeholder="shop.searchPlaceholder" autocomplete="off"/></label>
      <label><span data-i18n="shop.sort">Sort by</span><select id="shop-sort"><option value="featured" data-i18n="shop.sortFeatured">Featured first</option><option value="price-asc" data-i18n="shop.sortPriceAsc">Price: low to high</option><option value="price-desc" data-i18n="shop.sortPriceDesc">Price: high to low</option><option value="name" data-i18n="shop.sortName">Name</option><option value="stock" data-i18n="shop.sortStock">Limited stock</option></select></label>
    </div>
    <div id="shop-filters" class="filters"></div>
    <div id="shop-policy" class="shop-policy hidden"></div>
    <div class="shop-results-heading"><p id="shop-result-count" role="status" aria-live="polite">Loading products…</p><button id="shop-clear-filters" class="ghost-button small hidden" type="button">Clear filters</button></div>
    <div id="product-grid" class="product-grid loading-grid"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div>
    <nav id="shop-pagination" class="data-pagination hidden" aria-label="Shop product pages"><button class="ghost-button" data-shop-previous type="button">← Previous</button><span></span><button class="ghost-button" data-shop-next type="button">Next →</button></nav>
  </section>
  <section id="shop-history-section" class="wrap content-section hidden"><div class="view-heading"><div><p class="eyebrow">YOUR ACCOUNT</p><h2>Purchase history</h2></div><div class="history-filters"><label><span class="sr-only">Search purchase history</span><input id="history-search" type="search" placeholder="Search order or item"/></label><label><span class="sr-only">Filter purchase status</span><select id="history-status"><option value="">All statuses</option><option value="pending">Pending</option><option value="delivered">Delivered</option><option value="review">Review</option><option value="failed">Failed</option><option value="refunded">Refunded</option></select></label></div></div><div id="shop-history" class="admin-table"></div></section>
  <dialog id="purchase-dialog"><button class="dialog-close" aria-label="Close">×</button><p class="eyebrow">Confirm order</p><h2 id="purchase-title">Purchase</h2><p>Choose an offline character. The order is queued for safe in-game delivery.</p><label id="purchase-variant-field" class="hidden">Option<select id="purchase-variant"></select></label><label>Character<select id="purchase-character"></select></label><label>Coupon (optional)<input id="purchase-coupon" maxlength="40" placeholder="WELCOME"/></label><div class="order-total"><span>Total before discount</span><strong id="purchase-price"></strong></div><button id="purchase-confirm" class="button full">Queue delivery →</button><p class="form-message"></p></dialog>
</Layout>
