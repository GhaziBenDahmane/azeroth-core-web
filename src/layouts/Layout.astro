---
/* Load order is load-bearing:
   1. the existing base + component layer (`webcore.scss`, `global.css`,
      `enhancements.css`, `modern.css`) still styles what `public/js/*` renders,
      and owns `.hidden`, `.muted`, `.wrap` and the box-sizing reset;
   2. `tokens.css` then replaces the palette, type ramp and scale;
   3. `shell.css` supplies the new left rail and top bar;
   4. `motion.css` is additive;
   5. `bridge.css` maps the page components onto the new tokens.
   `components.css` and `home.css` are intentionally NOT loaded: they style this
   repo's own markup vocabulary, which this line of the portal does not render. */
import '../styles/webcore.scss';
import '../styles/global.css';
import '../styles/enhancements.css';
import '../styles/modern.css';
import '../styles/tokens.css';
import '../styles/shell.css';
import '../styles/motion.css';
import '../styles/bridge.css';

const { title = 'Valenoza Portal', page = 'home', description = '' } = Astro.props;
const desc = description || 'Valenoza — a Wrath of the Lich King realm: play, armory, rankings, community and shop.';

/* Inline stroke icons keep the rail dependency-free and themable. */
const icons = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V20h13V9.5"/>',
  play: '<path d="M7 4.5h10a4 4 0 0 1 4 4v7a4 4 0 0 1-4 4h-1.6l-2.2 3-2.2-3H7a4 4 0 0 1-4-4v-7a4 4 0 0 1 4-4Z"/><path d="M9 9.5h1.5M9.9 8.6v1.8"/><circle cx="15" cy="10" r="1"/>',
  realm: '<circle cx="12" cy="12" r="9"/><path d="M3.5 9h17M3.5 15h17"/><path d="M12 3c2.4 2.3 3.6 5.3 3.6 9S14.4 18.7 12 21c-2.4-2.3-3.6-5.3-3.6-9S9.6 5.3 12 3Z"/>',
  armory: '<path d="M12 3.2 19.5 6v5.2c0 4.5-3.1 7.7-7.5 9.6-4.4-1.9-7.5-5.1-7.5-9.6V6z"/><path d="M12 8.4v5.2M9.6 11h4.8"/>',
  rankings: '<path d="M5 20h14"/><rect x="4" y="12" width="4.2" height="8" rx="1"/><rect x="9.9" y="7" width="4.2" height="13" rx="1"/><rect x="15.8" y="15" width="4.2" height="5" rx="1"/>',
  guilds: '<circle cx="9" cy="9" r="3"/><circle cx="16.5" cy="10.5" r="2.3"/><path d="M3.5 20c0-3.1 2.5-5.2 5.5-5.2s5.5 2.1 5.5 5.2"/><path d="M16.5 20c0-1.7.7-3 1.8-3.9"/>',
  community: '<circle cx="12" cy="12" r="8.5"/><path d="M8.5 12h7M12 8.5v7"/>',
  tools: '<path d="M14.5 6.5a3.5 3.5 0 0 1 4.9 4.2l-7 7-3.2.9.9-3.2Z"/><path d="m5 5 3 3M4 9l3-1"/>',
  tracker: '<path d="M5 5h14v11H9l-4 3.5Z"/><path d="M9 9h6M9 12h4"/>',
  vote: '<path d="m5 13 4.5 4.5L19 7.5"/>',
  shop: '<path d="M5 8h14l-1.1 11.2a1.5 1.5 0 0 1-1.5 1.3H7.6a1.5 1.5 0 0 1-1.5-1.3z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>',
  account: '<circle cx="12" cy="8.5" r="3.6"/><path d="M4.8 20.2c0-3.6 3.2-6.1 7.2-6.1s7.2 2.5 7.2 6.1"/>',
  security: '<rect x="4.5" y="10.5" width="15" height="10" rx="2.2"/><path d="M8.2 10.5V8a3.8 3.8 0 0 1 7.6 0v2.5"/>',
  sessions: '<rect x="3.5" y="4.5" width="17" height="12" rx="2"/><path d="M8.5 20h7M12 16.5V20"/>',
  support: '<path d="M20.5 12c0 4.4-3.8 7.6-8.5 7.6-1 0-2-.2-2.9-.5L4.5 20.5l1.4-3.9A7.4 7.4 0 0 1 3.5 12C3.5 7.6 7.3 4.4 12 4.4s8.5 3.2 8.5 7.6Z"/>',
  activity: '<path d="M3.5 12h4l2.5-6 3.5 12 2.5-6h4.5"/>',
  admin: '<path d="M4 6.5h16M4 12h16M4 17.5h16"/><circle cx="9" cy="6.5" r="1.6"/><circle cx="15" cy="12" r="1.6"/><circle cx="7.5" cy="17.5" r="1.6"/>',
};

/* Mirrors the site's information architecture, including the routes this line
   of the portal added (play, community, tools, tracker, vote, security). */
const nav = [
  {
    label: 'Play',
    links: [
      { key: 'home', href: '/', label: 'Home', icon: 'home' },
      { key: 'play', href: '/play', label: 'How to play', icon: 'play' },
      { key: 'realm', href: '/realm', label: 'Realm status', icon: 'realm' },
      { key: 'shop', href: '/shop', label: 'Shop', icon: 'shop' },
    ],
  },
  {
    label: 'Characters',
    links: [
      { key: 'armory', href: '/armory', label: 'Armory', icon: 'armory' },
      { key: 'rankings', href: '/rankings', label: 'Rankings', icon: 'rankings' },
      { key: 'guilds', href: '/guilds', label: 'Guilds', icon: 'guilds' },
    ],
  },
  {
    label: 'Community',
    links: [
      { key: 'community', href: '/community', label: 'Community', icon: 'community' },
      { key: 'tracker', href: '/tracker', label: 'Issue tracker', icon: 'tracker' },
      { key: 'vote', href: '/vote', label: 'Vote', icon: 'vote' },
      { key: 'tools', href: '/tools', label: 'Tools', icon: 'tools' },
    ],
  },
  {
    label: 'Account',
    auth: true,
    links: [
      { key: 'account', href: '/account', label: 'Overview', icon: 'account' },
      { key: 'security', href: '/account/security', label: 'Security', icon: 'security' },
      { key: 'sessions', href: '/account/sessions', label: 'Sessions', icon: 'sessions' },
      { key: 'support', href: '/account/support', label: 'Support', icon: 'support' },
      { key: 'activity', href: '/account/activity', label: 'Activity', icon: 'activity' },
    ],
  },
];

const icon = (name) =>
  `<svg class="rail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name] || icons.home}</svg>`;
---

<!doctype html>
<html lang="en" data-theme="dark" data-brand-default="Valenoza">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body data-page={page}>
    <a class="skip-link sr-only" href="#main-content">Skip to main content</a>
    <div id="maintenance-banner" class="maintenance-banner hidden"></div>

    <!-- ======================= LEFT RAIL ======================= -->
    <aside class="rail" id="rail" aria-label="Primary">
      <div class="rail-head">
        <a class="rail-brand" href="/" aria-label="Realm portal home">
          <img class="brand-logo hidden" data-brand-logo alt="" />
          <span class="brand-mark" data-brand-mark aria-hidden="true">V</span>
          <span class="rail-brand-text">
            <strong data-brand-name>VALENOZA</strong>
            <small>Realm portal</small>
          </span>
        </a>
        <button class="burger" id="rail-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="rail">
          <span></span><span></span><span></span>
        </button>
      </div>

      <nav class="rail-nav">
        {nav.map((group) => (
          <div class={group.auth ? 'rail-group signed-in hidden' : 'rail-group'}>
            <p class="rail-label">{group.label}</p>
            {group.links.map((link) => (
              <a class="rail-link" href={link.href} data-nav={link.key} data-i18n={`nav.${link.key}`} title={link.label}>
                <Fragment set:html={icon(link.icon)} />
                <span class="rail-text">{link.label}</span>
              </a>
            ))}
            {group.auth && (
              <a class="rail-link admin-link hidden" href="/admin" data-nav="admin" title="Control panel" data-i18n="account.admin">
                <Fragment set:html={icon('admin')} />
                <span class="rail-text">Control panel</span>
              </a>
            )}
          </div>
        ))}
      </nav>

      <div class="rail-foot">
        <label class="realm-switcher hidden">
          <span class="rail-text">Realm</span>
          <select id="realm-switcher" aria-label="Select realm"></select>
        </label>
        <a class="rail-link" href="/security" data-nav="security-page" title="Security">
          <Fragment set:html={icon('security')} />
          <span class="rail-text">Security</span>
        </a>
        <button id="theme-toggle" class="rail-link rail-button" type="button" aria-label="Use light mode" title="Use light mode">
          <svg class="rail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"/>
            <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/>
          </svg>
          <span class="rail-text">Theme</span>
        </button>
      </div>
    </aside>
    <div class="rail-backdrop" id="rail-backdrop" hidden></div>

    <!-- ======================= CONTENT ======================= -->
    <div class="app-main">
      <header class="topbar">
        <button class="burger topbar-burger" id="topbar-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="rail">
          <span></span><span></span><span></span>
        </button>
        <span class="topbar-title" id="topbar-title">{title}</span>
        <div class="topbar-actions">
          <a class="ghost-button small header-signin signed-out" href="/login" data-i18n="action.signIn">Sign in</a>
          <a class="button small header-action signed-out" href="/register" data-i18n="action.register">Create account</a>
          <div class="account-menu signed-in hidden">
            <button class="account-menu-trigger" type="button" aria-haspopup="true" aria-expanded="false">
              <span class="account-menu-label" data-i18n="action.account">My account</span>
              <span class="account-chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="account-dropdown" role="menu">
              <a href="/account" role="menuitem" data-i18n="account.overview">Account overview</a>
              <a href="/account/notifications" role="menuitem"><span data-i18n="account.notifications">Notifications</span> <span id="notification-badge" class="notification-badge hidden">0</span></a>
              <a class="admin-link hidden" href="/admin" role="menuitem" data-i18n="account.admin">Admin panel</a>
              <button class="account-signout" type="button" role="menuitem" data-i18n="action.signOut">Sign out</button>
            </div>
          </div>
        </div>
      </header>

      <main id="main-content" tabindex="-1"><slot /></main>

      <footer class="site-footer">
        <div class="wrap footer-inner">
          <div>
            <div class="footer-brand">
              <span class="brand-mark small" data-brand-mark aria-hidden="true">V</span>
              <span data-brand-name>VALENOZA</span>
            </div>
            <p data-footer-text>Valenoza is an independent community realm. Not affiliated with or endorsed by Blizzard Entertainment.</p>
            <a id="default-hero-credit" class="photo-credit" href="https://commons.wikimedia.org/wiki/File:Steinfjord_Senja_Norway_(137838339).jpeg" target="_blank" rel="noreferrer">Aurora photo: Francesco Russo · CC BY 3.0 · Character artwork © Blizzard Entertainment</a>
          </div>
          <nav class="footer-links" aria-label="Footer">
            <div>
              <p class="eyebrow">Play</p>
              <a href="/play" data-i18n="nav.play">How to play</a>
              <a href="/armory" data-i18n="nav.armory">Armory</a>
              <a href="/rankings" data-i18n="nav.rankings">Rankings</a>
            </div>
            <div>
              <p class="eyebrow">Realm</p>
              <a href="/realm" data-i18n="nav.realm">Realm status</a>
              <a href="/guilds" data-i18n="nav.guilds">Guilds</a>
              <a href="/shop" data-i18n="nav.shop">Shop</a>
            </div>
            <div>
              <p class="eyebrow">Community</p>
              <a href="/community" data-i18n="nav.community">Community</a>
              <a href="/tracker" data-i18n="nav.tracker">Issue tracker</a>
              <a href="/vote" data-i18n="nav.vote">Vote</a>
              <a href="/tools" data-i18n="nav.tools">Tools</a>
              <a href="/security">Security</a>
              <a class="config-terms hidden" rel="noreferrer" data-i18n="footer.terms">Terms</a>
              <a class="config-privacy hidden" rel="noreferrer" data-i18n="footer.privacy">Privacy</a>
            </div>
          </nav>
        </div>
      </footer>
    </div>

    <!-- Shared shell dialogs and toast are part of the shell contract: app.js
         (askAction, requestStepUp, toast) drives them by these ids. -->
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <dialog id="action-dialog" class="admin-dialog">
      <button class="dialog-close" type="button" aria-label="Close">×</button>
      <h2 id="action-dialog-title">Confirm action</h2>
      <p id="action-dialog-message" class="muted"></p>
      <form id="action-dialog-form">
        <label id="action-dialog-field">Confirmation<input name="value" autocomplete="off"/></label>
        <div class="row-actions">
          <button class="button" type="submit">Continue</button>
          <button class="ghost-button" type="button" data-action-cancel>Cancel</button>
        </div>
        <p class="form-message"></p>
      </form>
    </dialog>

    <dialog id="step-up-dialog" class="admin-dialog">
      <button class="dialog-close" type="button" aria-label="Close">×</button>
      <p class="eyebrow">Security check</p>
      <h2>Confirm it is you</h2>
      <p class="muted">For sensitive staff actions, confirm your account password. If two-factor authentication is enabled, also enter an authenticator or recovery code.</p>
      <form id="step-up-form">
        <label>Password<input name="password" type="password" autocomplete="current-password" required/></label>
        <label>Authenticator or recovery code<input name="code" autocomplete="one-time-code"/></label>
        <div class="row-actions">
          <button class="button" type="submit">Confirm for 10 minutes</button>
          <button class="ghost-button" type="button" data-step-up-cancel>Cancel</button>
        </div>
        <p class="form-message"></p>
      </form>
    </dialog>

    <script is:inline type="module" src="/app.js"></script>
  </body>
</html>
