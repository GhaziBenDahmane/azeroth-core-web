---
import '../styles/global.css';
import '../styles/enhancements.css';
const { title = 'Azeroth Portal', page = 'home' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Your gateway to the realm: account registration, armory and shop." />
  <title>{title}</title>
</head>
<body data-page={page}>
  <div class="sky" aria-hidden="true"><i></i><i></i><i></i></div>
  <header class="nav wrap">
    <a class="brand" href="/"><img class="brand-logo hidden" data-brand-logo alt=""/><span class="brand-mark" data-brand-mark>A</span><span data-brand-name>AZEROTH<small>REALM PORTAL</small></span></a>
    <nav aria-label="Primary navigation">
      <a href="/" data-i18n="nav.home">Home</a><a href="/armory" data-i18n="nav.armory">Armory</a><a href="/rankings" data-i18n="nav.rankings">Rankings</a><a href="/guilds" data-i18n="nav.guilds">Guilds</a><a href="/realm" data-i18n="nav.realm">Realm</a><a href="/shop" data-i18n="nav.shop">Shop</a>
    </nav>
    <div class="nav-actions"><a class="text-link signed-out" href="/login" data-i18n="action.signIn">Sign in</a><a class="button small signed-out" href="/register" data-i18n="action.register">Join realm</a><a class="button small signed-in hidden" href="/account" data-i18n="action.account">My account</a></div>
  </header>
  <main><slot /></main>
  <footer class="wrap"><div class="brand muted"><img class="brand-logo small hidden" data-brand-logo alt=""/><span class="brand-mark small" data-brand-mark>A</span><span data-brand-name>AZEROTH</span></div><p data-footer-text>Independent community realm portal. Not affiliated with Blizzard Entertainment.</p><div><a href="/armory" data-i18n="nav.armory">Armory</a><a href="/rankings" data-i18n="nav.rankings">Rankings</a><a href="/guilds" data-i18n="nav.guilds">Guilds</a><a href="/realm" data-i18n="nav.realm">Realm</a><a href="/shop" data-i18n="nav.shop">Shop</a><a class="config-community hidden" rel="noreferrer" data-i18n="footer.community">Community</a><a class="config-terms hidden" rel="noreferrer" data-i18n="footer.terms">Terms</a><a class="config-privacy hidden" rel="noreferrer" data-i18n="footer.privacy">Privacy</a></div></footer>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>
  <script is:inline src="/app.js"></script>
</body>
</html>
